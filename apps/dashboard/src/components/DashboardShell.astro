---
import DashboardHeader from "./DashboardHeader.astro";
import RadarPanel from "./RadarPanel.astro";
import ThroughputPanel from "./ThroughputPanel.astro";
import BenchmarkMatrix from "./BenchmarkMatrix.astro";
import FailureHeatmapPanel from "./FailureHeatmapPanel.astro";
import SystemResources from "./SystemResources.astro";
import type { ModelSummary, BenchmarkResult } from "../lib/loadResults";
import type { TraceStats } from "../lib/loadTraces";

interface Props {
    models: ModelSummary[];
    results: BenchmarkResult[];
    uniqueModels: string[];
    avgLatencyMs: string;
    avgMemoryGB: string;
    totalMemoryGB: string;
    p95LatencyMs: string;
    memoryUtilPct: number;
    topModels: ModelSummary[];
    traceStats?: TraceStats;
}

const {
    models,
    results,
    uniqueModels,
    avgLatencyMs,
    avgMemoryGB,
    totalMemoryGB,
    p95LatencyMs,
    memoryUtilPct,
    topModels,
    traceStats,
} = Astro.props;
---

<DashboardHeader
    title="Model Performance Overview"
    subtitle={`Cross-evaluation of local LLM performance on unified hardware clusters.${uniqueModels.length > 0 ? ` ${uniqueModels.length} models · ${results.length} runs` : ""}`}
/>

<!-- ═══ Charts Row: Radar + Throughput ════════════════════ -->
<section class="dashboard-charts">
    <RadarPanel models={models} topModels={topModels} />
    <ThroughputPanel models={models} />
</section>

<!-- ═══ Benchmark Matrix Table ═══════════════════════════ -->
<BenchmarkMatrix models={models} />

<!-- ═══ Failure Breakdown ════════════════════════════════ -->
<FailureHeatmapPanel results={results} />

<!-- ═══ System Resources ═════════════════════════════════ -->
<SystemResources
    avgLatencyMs={avgLatencyMs}
    avgMemoryGB={avgMemoryGB}
    totalMemoryGB={totalMemoryGB}
    p95LatencyMs={p95LatencyMs}
    memoryUtilPct={memoryUtilPct}
    resultsCount={results.length}
/>

<!-- ═══ Trace Overview (V2) ══════════════════════════════ -->
{
  traceStats && traceStats.total > 0 && (
    <section class="dashboard-table" style="margin-top: 2rem;">
      <div class="section-header">
        <h2>Execution Traces</h2>
        <p>
          Step-by-step execution replay across {traceStats.total} captured trace
          {traceStats.total !== 1 ? "s" : ""}
        </p>
      </div>
      <div class="card">
        <div class="trace-stats-grid">
          <div class="trace-stat-item">
            <span class="material-symbols-outlined trace-stat-icon" style="color: var(--brand-primary);">
              replay
            </span>
            <span class="trace-stat-value">{traceStats.total}</span>
            <span class="trace-stat-label">Total Traces</span>
          </div>
          <div class="trace-stat-item">
            <span class="material-symbols-outlined trace-stat-icon" style="color: var(--success);">
              check_circle
            </span>
            <span class="trace-stat-value">{traceStats.completed}</span>
            <span class="trace-stat-label">Completed</span>
          </div>
          <div class="trace-stat-item">
            <span class="material-symbols-outlined trace-stat-icon" style="color: var(--error);">
              cancel
            </span>
            <span class="trace-stat-value">{traceStats.failed}</span>
            <span class="trace-stat-label">Failed</span>
          </div>
          <div class="trace-stat-item">
            <span class="material-symbols-outlined trace-stat-icon" style="color: var(--warning);">
              dns
            </span>
            <span class="trace-stat-value">{traceStats.modelsWithTraces}</span>
            <span class="trace-stat-label">Models Tracked</span>
          </div>
        </div>
        <div class="trace-stats-cta">
          <a href="/traces" class="btn-outline">
            <span class="material-symbols-outlined" style="font-size: 18px;">
              replay
            </span>
            <span>Explore execution traces</span>
          </a>
        </div>
      </div>
    </section>
  )
}
