---
export interface Props {
    title: string;
    description?: string;
    activeNav?:
        | "models"
        | "benchmarks"
        | "agentic"
        | "snapshots"
        | "workload"
        | "leaderboard"
        | "packs"
        | "history"
        | "replays";
}

import RunBenchmarkButton from "../components/RunBenchmarkButton";
import ConnectionStatusBadge from "../components/ConnectionStatusBadge";
import ServerUptimeBadge from "../components/ServerUptimeBadge";
import BenchmarkStatusBadge from "../components/BenchmarkStatusBadge";
import ReplayToast from "../components/ReplayToast";
import ReplaySidebarBadge from "../components/ReplaySidebarBadge";

const { title, description, activeNav = "models" } = Astro.props;

const navItems = [
    { id: "models", icon: "view_in_ar", label: "Models", href: "/" },
    {
        id: "benchmarks",
        icon: "analytics",
        label: "Benchmarks",
        href: "/compare",
    },
    {
        id: "agentic",
        icon: "account_tree",
        label: "Agentic Traces",
        href: "/traces",
    },
    {
        id: "replays",
        icon: "replay",
        label: "Replay Viewer",
        href: "/replays",
    },
    {
        id: "leaderboard",
        icon: "leaderboard",
        label: "Leaderboard",
        href: "/leaderboard",
    },
    {
        id: "packs",
        icon: "architecture",
        label: "Prompt Packs",
        href: "/prompt-packs",
    },
    {
        id: "snapshots",
        icon: "camera",
        label: "Snapshots",
        href: "/snapshots",
    },
    {
        id: "workload",
        icon: "code",
        label: "Workload",
        href: "/workload",
    },
    { id: "history", icon: "history", label: "Runs History", href: "/history" },
] as const;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <!-- ── Theme initialization (blocks flash) ───────────────── -->
        <script>
            (function () {
                /* Cross-fade page transitions */
                document.documentElement.style.setProperty(
                    "--page-transition-duration",
                    "200ms",
                );
                var theme = localStorage.getItem("modellens-theme");
                if (theme === "light") {
                    document.documentElement.classList.remove("dark");
                    document.documentElement.classList.add("light");
                } else if (!theme) {
                    // default to dark if no preference
                    localStorage.setItem("modellens-theme", "dark");
                }
            })();
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta
            name="description"
            content={description ||
                "Model Lens Benchmark Dashboard — local LLM evaluation on Apple Silicon"}
        />
        <title>{title} | Model Lens</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Stitch Kinetic Logic: Typography -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <!-- Preload font CSS for early discovery (non-render-blocking) -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
            />
        </noscript>

        <!-- Material Symbols Outlined -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
            />
        </noscript>
    </head>
    <body>
        <!-- ── Skip to content (keyboard/screenreader skip-link) ──── -->
        <a href="#main-content" class="skip-link">Skip to content</a>
        <!-- ── Mobile menu toggle (hidden checkbox) ───────────────── -->
        <input
            type="checkbox"
            id="menu-toggle"
            class="menu-toggle-input"
            aria-hidden="true"
        />

        <!-- ── Sidebar Navigation ──────────────────────────────────── -->
        <aside class="sidebar" transition:persist="sidebar">
            <div class="sidebar-brand" transition:animate="slide">
                <h1 class="brand-title">Model Lens</h1>
                <p class="brand-subtitle">Benchmark Platform</p>
            </div>
            <nav class="sidebar-nav">
                {
                    navItems.slice(0, 3).map((item) => (
                        <a
                            href={item.href}
                            class={`sidebar-link ${activeNav === item.id ? "sidebar-link-active" : ""}`}
                            transition:name={`nav-${item.id}`}
                        >
                            <span class="material-symbols-outlined sidebar-icon">
                                {item.icon}
                            </span>
                            <span>{item.label}</span>
                        </a>
                    ))
                }
                <a
                    href="/replays"
                    class={`sidebar-link ${activeNav === "replays" ? "sidebar-link-active" : ""}`}
                    transition:name="nav-replays"
                >
                    <span class="material-symbols-outlined sidebar-icon"
                        >replay</span
                    >
                    <span class="sidebar-link-label">Replay Viewer</span>
                    <ReplaySidebarBadge client:load />
                </a>
                {
                    navItems.slice(4).map((item) => (
                        <a
                            href={item.href}
                            class={`sidebar-link ${activeNav === item.id ? "sidebar-link-active" : ""}`}
                            transition:name={`nav-${item.id}`}
                        >
                            <span class="material-symbols-outlined sidebar-icon">
                                {item.icon}
                            </span>
                            <span>{item.label}</span>
                        </a>
                    ))
                }
                <a
                    href="https://modellens-docs.pages.dev"
                    class="sidebar-link"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="material-symbols-outlined sidebar-icon"
                        >open_in_new</span
                    >
                    <span>Docs</span>
                </a>
            </nav>
            <div class="sidebar-footer">
                <button
                    class="sidebar-link theme-toggle"
                    id="theme-toggle"
                    aria-label="Toggle dark/light mode"
                    title="Toggle dark/light mode"
                >
                    <span
                        class="material-symbols-outlined sidebar-icon theme-toggle-icon-dark"
                        aria-hidden="true">dark_mode</span
                    >
                    <span
                        class="material-symbols-outlined sidebar-icon theme-toggle-icon-light"
                        style="display:none"
                        aria-hidden="true">light_mode</span
                    >
                    <span class="theme-toggle-label">Dark mode</span>
                </button>
                <script>
                    (function () {
                        var btn = document.getElementById("theme-toggle");
                        if (!btn) return;
                        var darkIcon = btn.querySelector(
                            ".theme-toggle-icon-dark",
                        );
                        var lightIcon = btn.querySelector(
                            ".theme-toggle-icon-light",
                        );
                        var label = btn.querySelector(".theme-toggle-label");
                        var html = document.documentElement;

                        function updateUI() {
                            var isDark = html.classList.contains("dark");
                            if (darkIcon)
                                darkIcon.style.display = !isDark ? "" : "none";
                            if (lightIcon)
                                lightIcon.style.display = !isDark ? "none" : "";
                            if (label)
                                label.textContent = !isDark
                                    ? "Dark mode"
                                    : "Light mode";
                        }

                        updateUI();

                        btn.onclick = function () {
                            var isDark = html.classList.contains("dark");
                            if (isDark) {
                                html.classList.remove("dark");
                                html.classList.add("light");
                                localStorage.setItem(
                                    "modellens-theme",
                                    "light",
                                );
                            } else {
                                html.classList.remove("light");
                                html.classList.add("dark");
                                localStorage.setItem("modellens-theme", "dark");
                            }
                            updateUI();
                        };
                    })();
                </script>
            </div>
        </aside>

        <!-- ── Mobile overlay backdrop ─────────────────────────────── -->
        <label for="menu-toggle" class="menu-backdrop" aria-hidden="true"
        ></label>

        <!-- ── Top Header Bar ──────────────────────────────────────── -->
        <header class="topbar" transition:animate="slide">
            <div class="topbar-left">
                <!-- Hamburger button (visible on mobile only) -->
                <label
                    for="menu-toggle"
                    class="hamburger-btn"
                    aria-label="Toggle navigation menu"
                    title="Toggle navigation menu"
                >
                    <span
                        class="material-symbols-outlined hamburger-icon hamburger-open"
                        >menu</span
                    >
                    <span
                        class="material-symbols-outlined hamburger-icon hamburger-close"
                        >close</span
                    >
                </label>
                <form
                    class="search-wrapper"
                    action="/"
                    method="get"
                    role="search"
                >
                    <label for="search-input" class="sr-only"
                        >Search models or benchmarks</label
                    >
                    <span
                        class="material-symbols-outlined search-icon"
                        aria-hidden="true">search</span
                    >
                    <input
                        id="search-input"
                        class="search-input"
                        type="text"
                        placeholder="Search models or benchmarks..."
                        name="q"
                        autocomplete="off"
                    />
                </form>
            </div>
            <div class="topbar-right">
                <ServerUptimeBadge client:load />
                <ConnectionStatusBadge client:load />
                <div class="hardware-badge">
                    <span class="material-symbols-outlined hw-icon"
                        >sensors</span
                    >
                    <span class="hw-label">Apple M3 Pro (18GB)</span>
                </div>
                <RunBenchmarkButton client:load />
            </div>
        </header>

        <!-- ── Main Content ─────────────────────────────────────────── -->
        <main id="main-content" class="main-canvas" transition:animate="fade">
            <slot />
        </main>

        <!-- ── Floating Node Status ─────────────────────────────────── -->
        <BenchmarkStatusBadge client:load />
        <ReplayToast client:load />
    </body>
</html>

<style is:global>
    /* ═══════════════════════════════════════════════════════════════
     KINETIC LOGIC — Design System
     Model Lens Benchmark Platform
     ═══════════════════════════════════════════════════════════════ */

    /* ── CSS Custom Properties (Stitch Palette) ──────────────────── */
    :root {
        /* Surfaces (tonal layering, 0-6) */
        --bg-canvas: #12131a;
        --bg-dim: #12131a;
        --bg-bright: #383941;
        --bg-lowest: #0d0e15;
        --bg-low: #1a1b22;
        --bg-container: #1e1f26;
        --bg-container-high: #292931;
        --bg-container-highest: #33343c;

        /* On-surfaces */
        --text-primary: #e3e1ec;
        --text-secondary: #c2c6d6;
        --text-tertiary: #8c909f;
        --text-disabled: #636674;

        /* Borders */
        --border-subtle: #33343c;
        --border-default: #424754;
        --border-prominent: #636674;

        /* Brand */
        --brand-primary: #adc6ff;
        --brand-primary-dim: #adc6ff;
        --brand-primary-container: #4d8eff;
        --brand-on-primary: #002e6a;
        --brand-on-primary-container: #00285d;

        /* Semantic */
        --success: #4edea3;
        --success-container: #00a572;
        --success-dim: #4edea3;
        --warning: #fbbf24;
        --warning-container: #b45309;
        --error: #ffb4ab;
        --error-container: #93000a;
        --tertiary: #ffb2b7;
        --tertiary-container: #ff516a;

        /* Extended semantic (from DESIGN.md YAML) */
        --on-secondary: #003824;
        --on-secondary-container: #00311f;
        --secondary-fixed: #6ffbbe;
        --secondary-fixed-dim: #4edea3;
        --tertiary-fixed: #ffdadb;
        --tertiary-fixed-dim: #ffb2b7;
        --inverse-primary: #005ac2;
        --surface-variant: #33343c;
        --on-tertiary: #67001b;
        --on-tertiary-container: #5b0017;
        --on-error: #690005;
        --on-error-container: #ffdad6;
        --on-primary-fixed: #001a42;
        --on-primary-fixed-variant: #004395;
        --on-secondary-fixed: #002113;
        --on-secondary-fixed-variant: #005236;
        --on-tertiary-fixed: #40000d;
        --on-tertiary-fixed-variant: #92002a;
        --inverse-surface: #e3e1ec;
        --inverse-on-surface: #2f3038;

        /* Fixed accents */
        --accent-fixed: #d8e2ff;
        --accent-fixed-dim: #adc6ff;
        --success-fixed: #6ffbbe;
        --success-fixed-dim: #4edea3;
        --tertiary-fixed: #ffdadb;
        --tertiary-fixed-dim: #ffb2b7;

        /* Typography */
        --font-ui:
            "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-mono: "JetBrains Mono", "SF Mono", "Fira Code", monospace;

        /* Shapes */
        --radius-none: 0;
        --radius-sm: 0.125rem;
        --radius-md: 0.25rem;
        --radius-lg: 0.375rem;
        --radius-xl: 0.5rem;
        --radius-full: 9999px;

        /* Spacing */
        --unit: 4px;
        --gutter: 1rem;
        --stack-sm: 0.5rem;
        --stack-md: 1rem;
        --container-pad: 1.5rem;
        --sidebar-w: 16rem;
        --topbar-h: 3rem;
    }

    /* ── Light Mode ────────────────────────────────────────────── */
    :root.light {
        /* Surfaces */
        --bg-canvas: #f5f5f7;
        --bg-dim: #f5f5f7;
        --bg-bright: #e8e8ed;
        --bg-lowest: #ffffff;
        --bg-low: #f0f0f2;
        --bg-container: #ffffff;
        --bg-container-high: #f5f5f7;
        --bg-container-highest: #e8e8ed;

        /* On-surfaces */
        --text-primary: #1d1d1f;
        --text-secondary: #515154;
        --text-tertiary: #86868b;
        --text-disabled: #aeaeb2;

        /* Borders */
        --border-subtle: #d2d2d7;
        --border-default: #c7c7cc;
        --border-prominent: #aeaeb2;

        /* Brand */
        --brand-primary: #005ac2;
        --brand-primary-dim: #4d8eff;
        --brand-on-primary: #ffffff;

        /* Extended semantic tweaks for light bg */
        --inverse-surface: #2f3038;
        --inverse-on-surface: #e3e1ec;
        --surface-variant: #e8e8ed;
    }
    :root.light .status-flyout,
    :root.light .traces-shortcuts-overlay {
        box-shadow: 0 8px 24px rgba(0, 10, 40, 0.12);
    }
    :root.light .rpv-toast {
        box-shadow: 0 8px 24px rgba(0, 10, 40, 0.16);
    }
    :root.light .node-status {
        box-shadow: 0 0 0 1px rgba(0, 90, 194, 0.08);
    }
    :root.light .traces-pb-thumb {
        border-color: #ffffff;
    }
    :root.light .heatmap-high {
        color: #005ac2;
    }

    /* ── Smooth theme transitions ────────────────────────────────── */
    *,
    *::before,
    *::after {
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            color 0.15s ease;
    }

    /* ── Orphan prevention ──────────────────────────────────────── */
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    p,
    li,
    .dashboard-title,
    .section-header h2,
    .page-hero h1,
    .card h3 {
        text-wrap: pretty;
    }

    /* ── Focus-visible: keyboard focus indicator for all interactive elements ── */
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    label:focus-visible,
    .btn-outline:focus-visible,
    .btn-primary:focus-visible,
    .sidebar-link:focus-visible,
    .theme-toggle:focus-visible,
    .traces-tab-btn:focus-visible,
    .traces-sidebar-export:focus-visible,
    .traces-tl-export:focus-visible,
    .traces-pb-btn:focus-visible,
    .traces-pb-help:focus-visible,
    .traces-filter-clear:focus-visible,
    .traces-filter-input:focus-visible,
    .packs-filter-chip:focus-visible,
    .pack-card-header:focus-visible,
    .model-card-overall:focus-visible,
    .sort-select:focus-visible,
    .hamburger-btn:focus-visible {
        outline: 2px solid var(--brand-primary);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
    }
    input:focus-visible:not(.traces-filter-input) {
        outline-offset: 0;
    }

    /* ── Reset ──────────────────────────────────────────────────── */
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* ── Grain overlay (subtle noise texture) — sits below floating UI ── */
    body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 10;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.02'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
        opacity: 0.4;
    }
    html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* ── Skip to content (keyboard users) ──────────────────────── */
    .skip-link {
        position: fixed;
        top: -100%;
        left: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        font-family: var(--font-ui);
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--radius-md);
        z-index: 9999;
        text-decoration: none;
        transition: top 0.15s ease;
    }
    .skip-link:focus {
        top: 0.5rem;
    }
    body {
        font-family: var(--font-ui);
        font-size: 14px;
        line-height: 20px;
        font-weight: 400;
        background: var(--bg-canvas);
        color: var(--text-primary);
        min-height: 100vh;
    }
    a {
        color: inherit;
        text-decoration: none;
    }
    img {
        max-width: 100%;
        display: block;
    }

    /* ── Custom Scrollbar ────────────────────────────────────────── */
    ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }
    ::-webkit-scrollbar-track {
        background: var(--bg-lowest);
    }
    ::-webkit-scrollbar-thumb {
        background: var(--border-default);
        border-radius: 2px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: var(--text-tertiary);
    }

    /* ── Material Symbols (Google Fonts) ─────────────────────────── */
    .material-symbols-outlined {
        font-variation-settings:
            "FILL" 0,
            "wght" 400,
            "GRAD" 0,
            "opsz" 24;
        font-size: 18px;
        line-height: 1;
        vertical-align: middle;
    }

    /* ═══════════════════════════════════════════════════════════════
     SIDEBAR
     ═══════════════════════════════════════════════════════════════ */
    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        width: var(--sidebar-w);
        height: 100vh;
        background: var(--bg-container);
        border-right: 1px solid var(--border-default);
        display: flex;
        flex-direction: column;
        z-index: 50;
    }
    .sidebar-brand {
        padding: 1.5rem 1.5rem 1rem;
    }
    .brand-title {
        font-family: var(--font-ui);
        font-size: 16px;
        font-weight: 600;
        line-height: 24px;
        color: var(--text-primary);
    }
    .brand-subtitle {
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 400;
        line-height: 18px;
        color: var(--text-secondary);
        opacity: 0.7;
    }

    .sidebar-nav {
        flex: 1;
        padding: 0 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 1px;
        overflow-y: auto;
    }
    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 400;
        color: var(--text-secondary);
        border-radius: var(--radius-md);
        transition:
            background-color 0.15s,
            color 0.15s;
        position: relative;
    }
    .sidebar-link:hover {
        background: var(--bg-container-highest);
        color: var(--text-primary);
    }
    .sidebar-link:active {
        transform: scale(0.98);
    }
    .sidebar-link-active {
        background: var(--bg-container-high);
        color: var(--brand-primary);
        font-weight: 600;
        border-right: 2px solid var(--brand-primary);
        border-radius: 0;
    }
    .sidebar-icon {
        font-size: 20px !important;
    }

    .sidebar-footer {
        padding: 0.75rem;
        border-top: 1px solid var(--border-default);
    }

    .theme-toggle {
        width: 100%;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--font-ui);
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        color: var(--text-secondary);
        border-radius: var(--radius-md);
        transition:
            background-color 0.15s,
            color 0.15s;
        position: relative;
    }
    .theme-toggle:hover {
        background: var(--bg-container-highest);
        color: var(--text-primary);
    }
    .theme-toggle:active {
        transform: scale(0.98);
    }
    .theme-toggle-label {
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 400;
    }

    /* ═══════════════════════════════════════════════════════════════
     TOP BAR
     ═══════════════════════════════════════════════════════════════ */
    .topbar {
        position: fixed;
        top: 0;
        right: 0;
        width: calc(100% - var(--sidebar-w));
        height: var(--topbar-h);
        background: var(--bg-canvas);
        border-bottom: 1px solid var(--border-default);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 var(--container-pad);
        z-index: 40;
    }
    .topbar-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .search-wrapper {
        position: relative;
    }
    .search-icon {
        position: absolute;
        left: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary);
        font-size: 18px !important;
    }
    .search-input {
        background: var(--bg-lowest);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        padding: 0.25rem 0.5rem 0.25rem 2rem;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-primary);
        width: 16rem;
        height: 2rem;
        outline: none;
        transition: border-color 0.15s;
    }
    .search-input:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 2px rgba(173, 198, 255, 0.35);
        outline: none;
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .search-input::placeholder {
        color: var(--text-tertiary);
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .hardware-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.75rem;
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
    }
    .hw-icon {
        font-size: 14px !important;
        color: var(--success);
    }
    .hw-label {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
    }

    /* Server Uptime Badge */
    .server-uptime-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--text-tertiary);
        cursor: default;
    }
    .uptime-icon {
        font-size: 14px !important;
        color: var(--text-tertiary);
    }
    .uptime-label {
        white-space: nowrap;
    }

    /* Connection Status Badge */
    .connection-badge {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.625rem;
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--text-secondary);
    }
    .connection-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .connection-dot.connected {
        background: var(--success);
        box-shadow: 0 0 6px rgba(78, 222, 163, 0.4);
        animation: pulse-dot 2s ease-in-out infinite;
    }
    .connection-dot.disconnected {
        background: var(--error);
    }
    .connection-label {
        white-space: nowrap;
    }
    .connection-badge-disconnected {
        border-color: rgba(255, 180, 171, 0.3);
        background: rgba(255, 180, 171, 0.04);
    }
    .connection-hint {
        color: var(--text-tertiary);
        font-size: 10px;
        opacity: 0.7;
    }

    .btn-primary {
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 600;
        padding: 0.375rem 0.875rem;
        border: none;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition:
            opacity 0.15s,
            transform 0.1s;
        height: 2rem;
        display: flex;
        align-items: center;
    }
    .btn-primary:hover {
        opacity: 0.9;
    }
    .btn-primary:active {
        opacity: 0.8;
        transform: scale(0.97);
    }

    /* ═══════════════════════════════════════════════════════════════
     MAIN CONTENT CANVAS
     ═══════════════════════════════════════════════════════════════ */
    .main-canvas {
        margin-left: var(--sidebar-w);
        padding-top: var(--topbar-h);
        padding: calc(var(--topbar-h) + 1.5rem) var(--container-pad) 5rem;
        min-height: 100vh;
    }
    @media (min-width: 1600px) {
        .main-canvas {
            max-width: calc(1440px + var(--sidebar-w));
        }
    }

    /* ── Section Headers ────────────────────────────────────────── */
    .section-header {
        margin-bottom: 1.5rem;
    }
    .section-header h2 {
        font-family: var(--font-ui);
        font-size: 24px;
        font-weight: 600;
        line-height: 32px;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }
    .section-header p {
        font-family: var(--font-ui);
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }

    /* ── Mono Label (uppercase metadata) ────────────────────────── */
    .mono-label {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        line-height: 16px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .mono-data {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 400;
        line-height: 20px;
    }

    /* ── Button Variants ────────────────────────────────────────── */
    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.75rem;
        background: var(--bg-container-high);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
            color 0.15s,
            border-color 0.15s;
    }
    .btn-outline:hover {
        color: var(--text-primary);
        border-color: var(--border-prominent);
        background: var(--bg-container-highest);
    }
    .btn-outline:active {
        transform: scale(0.97);
    }

    /* ── Cards (Stitch tonal elevation) ──────────────────────────── */
    .card {
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        padding: 1.5rem;
        transition:
            border-color 0.15s,
            background-color 0.15s;
    }
    .card:hover {
        border-color: var(--border-prominent);
    }
    .card-interactive {
        cursor: pointer;
    }
    .card-interactive:hover {
        background: var(--bg-container-high);
    }

    /* ── Grid Layouts ────────────────────────────────────────────── */
    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    .grid-12 {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1rem;
    }
    .col-span-4 {
        grid-column: span 4;
    }
    .col-span-5 {
        grid-column: span 5;
    }
    .col-span-6 {
        grid-column: span 6;
    }
    .col-span-7 {
        grid-column: span 7;
    }
    .col-span-8 {
        grid-column: span 8;
    }
    .col-span-12 {
        grid-column: span 12;
    }

    /* ── Empty states ────────────────────────────────────────────── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-tertiary);
        font-size: 0.95rem;
        background: var(--bg-container);
        border: 1px dashed var(--border-default);
        border-radius: var(--radius-lg);
        gap: 1rem;
        transition:
            border-color 0.2s,
            background 0.2s;
    }
    .empty-state-icon {
        font-size: 48px !important;
        opacity: 0.3;
        color: var(--text-tertiary);
    }
    .empty-state h3 {
        font-family: var(--font-ui);
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    /* ── Floating Node Status ────────────────────────────────────── */
    .node-status {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--bg-container-highest);
        border: 1px solid rgba(173, 198, 255, 0.3);
        border-radius: var(--radius-full);
        z-index: 20;
        transition: border-color 0.4s ease;
    }
    .node-status-active {
        border-color: rgba(251, 191, 36, 0.4);
        background-image: linear-gradient(
            90deg,
            transparent 0%,
            rgba(251, 191, 36, 0.04) 45%,
            rgba(251, 191, 36, 0.08) 50%,
            rgba(251, 191, 36, 0.04) 55%,
            transparent 100%
        );
        background-size: 200% 100%;
        animation: status-shimmer 2.5s ease-in-out infinite;
    }
    @keyframes status-shimmer {
        0% {
            background-position: 100% 0;
        }
        100% {
            background-position: -100% 0;
        }
    }

    /* Progress bar (indeterminate sweep along bottom edge) */
    .status-progress-track {
        position: absolute;
        bottom: 0;
        left: 2px;
        right: 2px;
        height: 2px;
        border-radius: 0 0 var(--radius-full) var(--radius-full);
        overflow: hidden;
        background: transparent;
    }
    .status-progress-bar {
        width: 40%;
        height: 100%;
        border-radius: 1px;
        background: rgba(251, 191, 36, 0.6);
        animation: status-progress-sweep 1.8s ease-in-out infinite;
    }
    @keyframes status-progress-sweep {
        0% {
            transform: translateX(-100%);
        }
        50% {
            transform: translateX(250%);
        }
        100% {
            transform: translateX(-100%);
        }
    }

    /* ── Done flash ─────────────────────────────────────────────── */
    .node-status-done {
        border-color: rgba(78, 222, 163, 0.4);
    }
    .status-dot-done {
        background: var(--success);
        animation: status-dot-done-flash 0.6s ease-out;
        box-shadow: 0 0 10px rgba(78, 222, 163, 0.6);
    }
    @keyframes status-dot-done-flash {
        0% {
            transform: scale(2);
            opacity: 0;
        }
        60% {
            transform: scale(0.9);
            opacity: 1;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
    .status-text-done {
        color: var(--success);
    }
    .status-id-clickable {
        cursor: pointer;
        padding: 2px 4px;
        margin: -2px -4px;
        border-radius: var(--radius-sm);
        transition:
            background 0.15s,
            color 0.15s;
    }
    .status-id-clickable:hover {
        background: rgba(173, 198, 255, 0.1);
        color: var(--brand-primary);
    }

    /* ── Flyout details panel ──────────────────────────────────── */
    .node-status-expanded {
        border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 0;
    }
    .status-flyout {
        position: absolute;
        bottom: calc(100% + 8px);
        right: 0;
        width: 230px;
        background: var(--bg-container-highest);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        padding: 0.625rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
        box-shadow: none;
        z-index: 19;
        animation: status-flyout-in 0.15s ease-out;
    }
    @keyframes status-flyout-in {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .status-flyout-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.25rem 0.375rem;
        border-radius: var(--radius-sm);
    }
    .status-flyout-label {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .status-flyout-value {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--text-primary);
        max-width: 130px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .status-flyout-value-running {
        color: var(--warning);
    }
    .status-flyout-link {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 0.25rem;
        padding: 0.375rem 0.5rem;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--brand-primary);
        background: var(--bg-container-high);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        text-decoration: none;
        transition:
            background 0.15s,
            border-color 0.15s;
    }
    .status-flyout-link:hover {
        background: var(--bg-container-highest);
        border-color: var(--brand-primary);
    }
    .status-flyout-link .material-symbols-outlined {
        font-size: 14px !important;
    }
    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--success);
        flex-shrink: 0;
    }
    .status-dot-active {
        background: var(--warning);
        animation: pulse-dot 1s ease-in-out infinite;
    }
    @keyframes pulse-dot {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.4;
        }
    }
    .status-text {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: var(--success);
        white-space: nowrap;
    }
    .status-text-active {
        color: var(--warning);
    }
    .status-kill-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        padding: 0;
        background: none;
        border: 1px solid var(--border-default);
        border-radius: 50%;
        cursor: pointer;
        transition:
            border-color 0.15s,
            background 0.15s;
        flex-shrink: 0;
    }
    .status-kill-btn:hover {
        border-color: var(--error);
        background: rgba(255, 180, 171, 0.1);
    }
    .status-kill-btn:disabled {
        opacity: 0.5;
        cursor: default;
    }
    .status-kill-icon {
        font-size: 14px !important;
        color: var(--text-tertiary);
        transition: color 0.15s;
    }
    .status-kill-btn:hover .status-kill-icon {
        color: var(--error);
    }
    .status-kill-spinner {
        width: 10px;
        height: 10px;
        border: 2px solid var(--border-default);
        border-top-color: var(--warning);
        border-radius: 50%;
        animation: spin-kill 0.6s linear infinite;
    }
    @keyframes spin-kill {
        to {
            transform: rotate(360deg);
        }
    }
    .status-divider {
        width: 1px;
        height: 1rem;
        background: var(--border-default);
        margin: 0 0.25rem;
    }
    .status-id {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-primary);
    }

    /* ═══════════════════════════════════════════════════════════════
     COMPONENT STYLES
     ═══════════════════════════════════════════════════════════════ */

    /* ── Model Table (Stitch-style) ─────────────────────────────────── */
    .model-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
    }
    .model-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

    /* Header */
    .th-model {
        padding: 0.75rem 1rem;
        text-align: left;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .th-score {
        padding: 0.75rem 1rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .th-overall {
        padding: 0.75rem 1rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }

    /* Cells */
    .td-model {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }
    .td-score {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        text-align: center;
        vertical-align: middle;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-primary);
    }
    .td-overall {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        text-align: center;
        vertical-align: middle;
    }

    .model-table tbody tr {
        transition: background-color 0.12s ease;
        cursor: pointer;
    }
    .model-table tbody tr:hover {
        background: var(--bg-container-highest);
    }
    .model-table tbody tr.row-top {
        background: rgba(173, 198, 255, 0.03);
    }

    /* Model cell */
    .model-cell {
        display: flex;
        flex-direction: column;
    }
    .model-link {
        font-family: var(--font-ui);
        font-weight: 600;
        color: var(--text-primary);
        transition: color 0.15s;
    }
    .model-link:hover {
        color: var(--brand-primary);
    }
    .model-sub {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
    }
    .model-trace-link {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: var(--text-tertiary);
        transition: color 0.15s;
    }
    .model-trace-link:hover {
        color: var(--brand-primary);
    }
    .model-trace-icon {
        font-size: 14px !important;
    }

    /* Score chips (matching target: secondary/10 background) */
    .score-chip {
        display: inline-block;
        padding: 1px 8px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
    }
    .score-chip-secondary {
        background: rgba(78, 222, 163, 0.08);
        color: var(--success);
    }

    /* Overall cell */
    .overall-cell {
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
        align-items: center;
    }
    .overall-value {
        font-family: var(--font-mono);
        font-size: 16px;
        font-weight: 700;
        color: var(--brand-primary);
    }

    /* ── Tier Badges ─────────────────────────────────────────────── */
    .tier-badge {
        display: inline-block;
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .tier-s {
        background: rgba(33, 150, 243, 0.3);
        color: var(--success);
    }
    .tier-a {
        background: rgba(76, 175, 80, 0.3);
        color: var(--brand-primary);
    }
    .tier-b {
        background: rgba(255, 235, 59, 0.3);
        color: var(--warning);
    }
    .tier-c {
        background: rgba(255, 165, 0, 0.3);
        color: var(--tertiary);
    }
    .tier-f {
        background: rgba(255, 99, 71, 0.3);
        color: var(--error);
    }

    /* ── ModelCard ─────────────────────────────────────────────────── */
    .model-card {
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition:
            border-color 0.2s,
            transform 0.15s;
    }
    .model-card:hover {
        border-color: var(--border-prominent);
        transform: translateY(-1px);
    }
    .model-card-top {
        border-color: rgba(173, 198, 255, 0.25);
    }

    .model-card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .model-card-rank {
        flex-shrink: 0;
    }
    .rank-emoji {
        font-size: 1.25rem;
    }
    .model-card-title {
        min-width: 0;
    }
    .model-card-name {
        font-family: var(--font-ui);
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .model-card-meta {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
        text-transform: uppercase;
    }

    .model-card-overall {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.75rem;
        background: var(--bg-low);
        border-radius: var(--radius-md);
        border: 1px solid var(--border-subtle);
        transition: background 0.15s;
    }
    .model-card-overall:hover {
        background: var(--bg-container-high);
    }
    .overall-label {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .model-card-metrics {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .metric-row {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }
    .metric-label {
        width: 80px;
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-secondary);
        flex-shrink: 0;
    }
    .metric-bar-track {
        flex: 1;
        height: 4px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 2px;
        overflow: hidden;
    }
    .metric-bar-fill {
        height: 100%;
        border-radius: 2px;
        background: var(--brand-primary);
        transition: width 0.4s ease;
    }
    .metric-val {
        width: 42px;
        text-align: right;
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 600;
        color: var(--text-tertiary);
        flex-shrink: 0;
    }

    .model-card-perf {
        display: flex;
        gap: 0.5rem;
    }
    .perf-badge {
        flex: 1;
        text-align: center;
        padding: 0.625rem 0.5rem;
        background: var(--bg-low);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
    }
    .perf-badge.metric-good {
        background: rgba(78, 222, 163, 0.06);
        border-color: rgba(78, 222, 163, 0.15);
    }
    .perf-badge.metric-ok {
        background: rgba(251, 191, 36, 0.06);
        border-color: rgba(251, 191, 36, 0.15);
    }
    .perf-badge.metric-slow {
        background: rgba(255, 180, 171, 0.06);
        border-color: rgba(255, 180, 171, 0.15);
    }
    .perf-value {
        display: block;
        font-family: var(--font-mono);
        font-size: 15px;
        font-weight: 700;
    }
    .perf-badge.metric-good .perf-value {
        color: var(--success);
    }
    .perf-badge.metric-ok .perf-value {
        color: var(--warning);
    }
    .perf-badge.metric-slow .perf-value {
        color: var(--error);
    }
    .perf-unit {
        display: block;
        font-family: var(--font-mono);
        font-size: 9px;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 2px;
    }

    .model-card-personality {
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-secondary);
        line-height: 1.5;
        font-style: italic;
    }

    /* ── Compare Table ─────────────────────────────────────────────── */
    .compare-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 500px;
    }
    .compare-table thead th {
        padding: 0.625rem 1rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .compare-table thead th:first-child {
        text-align: left;
        padding-left: 1rem;
    }
    .compare-table tbody td {
        padding: 0.75rem 1rem;
        text-align: center;
        border-bottom: 1px solid var(--border-subtle);
        font-family: var(--font-mono);
        font-size: 13px;
    }
    .compare-table tbody td:first-child {
        text-align: left;
        font-weight: 600;
        color: var(--text-secondary);
        font-family: var(--font-ui);
    }
    .compare-table tbody tr {
        transition: background 0.15s;
    }
    .compare-table tbody tr:hover {
        background: var(--bg-container-high);
    }
    .compare-table .row-separator td {
        border-top: 4px solid var(--border-default);
    }
    .cell-best {
        color: var(--success);
        font-weight: 600;
    }
    .cell-best .best-badge {
        display: inline-block;
        margin-left: 6px;
        font-size: 9px;
        font-weight: 600;
        font-family: var(--font-mono);
        text-transform: uppercase;
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        background: rgba(78, 222, 163, 0.1);
        vertical-align: middle;
    }

    /* ── ModelDetail ────────────────────────────────────────────────── */
    .metric-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1.5rem 1rem;
    }
    .metric-emoji {
        font-size: 1.5rem;
        margin-bottom: 0.375rem;
    }
    .metric-label-big {
        font-family: var(--font-ui);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-secondary);
    }
    .metric-value-big {
        font-family: var(--font-mono);
        font-size: 24px;
        font-weight: 700;
        margin-top: 0.25rem;
    }
    .perf-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .perf-stat {
        text-align: center;
    }
    .perf-stat-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .perf-stat-value {
        display: block;
        font-family: var(--font-mono);
        font-size: 28px;
        font-weight: 700;
        margin-top: 0.25rem;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    .stat-item {
        text-align: center;
    }
    .stat-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .stat-value {
        display: block;
        font-family: var(--font-mono);
        font-size: 22px;
        font-weight: 700;
        margin-top: 0.25rem;
    }
    .confidence-interval {
        margin-top: 1rem;
        text-align: center;
        padding: 0.75rem;
        background: var(--bg-low);
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-secondary);
    }
    .meta-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    .meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .meta-label {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .meta-item code {
        font-family: var(--font-mono);
        font-size: 12px;
        background: var(--bg-low);
        padding: 0.375rem 0.625rem;
        border-radius: var(--radius-sm);
        word-break: break-all;
        color: var(--text-primary);
    }

    /* ── Page Hero ─────────────────────────────────────────────────── */
    .page-hero {
        margin-bottom: 2rem;
    }
    .page-hero h1 {
        font-family: var(--font-ui);
        font-size: 24px;
        font-weight: 600;
        line-height: 32px;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }
    .page-hero p {
        font-family: var(--font-ui);
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }

    /* ── Utility classes ──────────────────────────────────────────── */
    .font-strong {
        font-size: 13px;
        font-weight: 600;
    }
    .text-tertiary {
        color: var(--text-tertiary);
    }
    .text-secondary {
        color: var(--text-secondary);
    }
    .td-label {
        font-weight: 600;
        color: var(--text-secondary);
    }
    .section-mt {
        margin-top: 2rem;
    }
    .mt-1 {
        margin-top: 0.5rem;
    }
    .mt-2 {
        margin-top: 1rem;
    }
    .mt-3 {
        margin-top: 1.5rem;
    }
    .mb-2 {
        margin-bottom: 1rem;
    }
    .mb-3 {
        margin-bottom: 1.5rem;
    }
    .inline-flex-center {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .font-small {
        font-size: 11px;
    }
    .mt-tiny {
        margin-top: 2px;
    }
    /* ── 404 page ────────────────────────────────────────────────── */
    .page-404 {
        padding: 5rem 2rem;
        text-align: center;
    }
    .icon-404 {
        font-size: 64px !important;
        color: var(--text-tertiary);
        margin-bottom: 1.5rem;
        display: block;
    }
    .heading-404 {
        font-family: var(--font-mono);
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }
    .text-404 {
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
    }
    .inline-code {
        background: var(--bg-low);
        padding: 6px 14px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--brand-primary);
        margin-top: 4px;
    }
    .icon-18 {
        font-size: 18px !important;
    }
    .icon-16 {
        font-size: 16px !important;
    }
    .icon-14 {
        font-size: 14px !important;
    }
    .icon-24 {
        font-size: 24px !important;
    }
    .icon-success {
        color: var(--success);
    }
    .icon-error {
        color: var(--error);
    }
    .icon-warning {
        color: var(--warning);
    }
    .icon-brand {
        color: var(--brand-primary);
    }
    .icon-tertiary {
        color: var(--text-tertiary);
    }
    .text-balance {
        max-width: 400px;
        line-height: 1.6;
        color: var(--text-secondary);
    }
    .delay-1 {
        animation-delay: 0.1s;
    }
    .delay-2 {
        animation-delay: 0.2s;
    }
    .delay-3 {
        animation-delay: 0.3s;
    }
    .delay-4 {
        animation-delay: 0.4s;
    }
    .btn-disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* ── Chips & Tags ──────────────────────────────────────────────── */
    .chip {
        display: inline-flex;
        align-items: center;
        padding: 1px 8px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
    }
    .chip-primary {
        background: rgba(173, 198, 255, 0.1);
        color: var(--brand-primary);
        border: 1px solid rgba(173, 198, 255, 0.2);
    }
    .chip-success {
        background: rgba(78, 222, 163, 0.1);
        color: var(--success);
        border: 1px solid rgba(78, 222, 163, 0.2);
    }
    .chip-warning {
        background: rgba(251, 191, 36, 0.1);
        color: var(--warning);
        border: 1px solid rgba(251, 191, 36, 0.2);
    }
    .chip-error {
        background: rgba(255, 180, 171, 0.1);
        color: var(--error);
        border: 1px solid rgba(255, 180, 171, 0.2);
    }

    /* ── Heatmap cell ───────────────────────────────────────────────── */
    .heatmap-cell {
        text-align: center;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
    }
    .heatmap-low {
        background: rgba(173, 198, 255, 0.08);
        color: var(--text-secondary);
    }
    .heatmap-mid {
        background: rgba(173, 198, 255, 0.18);
        color: var(--brand-primary);
    }
    .heatmap-high {
        background: rgba(173, 198, 255, 0.3);
        color: var(--accent-fixed);
        font-weight: 700;
    }

    /* ── Radar / Speed Chart ────────────────────────────────────────── */
    .radar-chart-container,
    .speed-chart-container,
    .heatmap-container {
        width: 100%;
        height: 100%;
    }
    .radar-chart-inner,
    .speed-chart-inner,
    .heatmap-inner {
        width: 100%;
        height: 100%;
    }

    /* ── Back Link ──────────────────────────────────────────────────── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-bottom: 1.5rem;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
        transition: color 0.15s;
    }
    .back-link:hover {
        color: var(--brand-primary);
    }

    /* ═══════════════════════════════════════════════════════════════
     DASHBOARD PAGE LAYOUT
     ═══════════════════════════════════════════════════════════════ */

    /* ── Header ──────────────────────────────────────────────────── */
    .dashboard-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 2rem;
    }
    .dashboard-title {
        font-family: var(--font-ui);
        font-size: 24px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        line-height: 32px;
    }
    .dashboard-subtitle {
        font-family: var(--font-ui);
        font-size: 14px;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }
    .dashboard-actions {
        display: flex;
        gap: 0.5rem;
    }

    /* ── Charts Grid ──────────────────────────────────────────────── */
    .dashboard-charts {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .chart-card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
    }
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }
    .chart-header h3 {
        font-family: var(--font-ui);
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 24px;
    }
    .chart-header p {
        font-family: var(--font-ui);
        font-size: 13px;
        color: var(--text-secondary);
        margin-top: 0.125rem;
    }
    .chart-body {
        flex: 1;
        min-height: 280px;
    }

    /* ── Chart Legend ─────────────────────────────────────────────── */
    .chart-legend {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        align-items: flex-end;
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .legend-dot-primary {
        background: var(--brand-primary);
    }
    .legend-dot-secondary {
        background: var(--success);
    }
    .legend-label {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    /* ── Context Window Badge ────────────────────────────────────── */
    .ctx-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .ctx-label {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-secondary);
        text-transform: uppercase;
    }
    .ctx-bar {
        width: 4rem;
        height: 4px;
        background: var(--bg-container-highest);
        border-radius: 2px;
        overflow: hidden;
    }
    .ctx-fill {
        width: 75%;
        height: 100%;
        background: var(--brand-primary);
    }
    .ctx-ticks {
        display: flex;
        justify-content: space-between;
        margin-top: 1rem;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
    }

    /* ── Dashboard Table ──────────────────────────────────────────── */
    .dashboard-table {
        margin-bottom: 2rem;
    }
    .table-card {
        padding: 0;
        overflow: hidden;
    }
    .table-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-default);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .table-header h3 {
        font-family: var(--font-ui);
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 24px;
    }
    .table-sort {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .sort-label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-secondary);
        text-transform: uppercase;
    }
    .sort-select {
        background: transparent;
        border: none;
        color: var(--brand-primary);
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        outline: none;
    }

    /* ── Dashboard Failures ───────────────────────────────────────── */
    .dashboard-failures {
        margin-bottom: 2rem;
    }

    /* ── Dashboard Resources ──────────────────────────────────────── */
    .dashboard-resources {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2rem;
    }
    .resource-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition:
            border-color 0.15s,
            background-color 0.15s;
    }
    .resource-card:hover {
        border-color: var(--border-prominent);
        background: var(--bg-container-high);
    }
    .resource-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .resource-icon-green {
        background: rgba(78, 222, 163, 0.1);
        color: var(--success);
    }
    .resource-icon-blue {
        background: rgba(173, 198, 255, 0.1);
        color: var(--brand-primary);
    }
    .resource-icon-rose {
        background: rgba(255, 178, 183, 0.1);
        color: var(--tertiary);
    }
    .resource-label {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .resource-value {
        font-family: var(--font-mono);
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        margin-top: 0.125rem;
    }
    .resource-subtitle {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-tertiary);
        margin-top: 0.125rem;
    }
    .resource-bar-track {
        width: 100%;
        height: 4px;
        background: var(--bg-container-highest);
        border-radius: 2px;
        overflow: hidden;
        margin-top: 0.5rem;
    }
    .resource-bar-fill {
        height: 100%;
        background: var(--success);
        border-radius: 2px;
        transition: width 0.6s ease;
        min-width: 2px;
    }

    /* ── Trace Stats Grid (Dashboard Overview V2) ───────────────── */
    .trace-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        padding: 1.5rem 1.5rem 1rem;
    }
    .trace-stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        text-align: center;
    }
    .trace-stat-icon {
        font-size: 24px !important;
        margin-bottom: 0.25rem;
    }
    .trace-stat-value {
        font-family: var(--font-mono);
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }
    .trace-stat-label {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .trace-stats-cta {
        padding: 1rem 1.5rem 1.5rem;
        display: flex;
        justify-content: center;
    }

    /* ── Shimmer / Skeleton Loading ──────────────────────────────── */
    @keyframes shimmer-slide {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }
    .skeleton-pulse {
        background: linear-gradient(
            90deg,
            var(--bg-container-highest) 0%,
            var(--bg-bright) 30%,
            var(--bg-container-highest) 60%
        );
        background-size: 200% 100%;
        animation: shimmer-slide 1.8s ease-in-out infinite;
        border-radius: var(--radius-sm);
    }
    .skeleton-text {
        height: 12px;
        width: 100%;
        margin-bottom: 6px;
    }
    .skeleton-text-short {
        width: 60%;
    }
    .skeleton-badge {
        height: 24px;
        width: 140px;
        border-radius: var(--radius-md);
    }
    .skeleton-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .skeleton-row {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }
    .skeleton-cell {
        height: 20px;
        border-radius: var(--radius-sm);
    }

    /* ── Entrance Animation ───────────────────────────────────────── */
    @keyframes fadeInSlideUp {
        from {
            opacity: 0;
            transform: translateY(5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-entrance {
        animation: fadeInSlideUp 0.5s ease-out forwards;
    }

    /* ═══════════════════════════════════════════════════════════════
     LEADERBOARD TABLE
     ═══════════════════════════════════════════════════════════════ */

    .leaderboard-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
    }
    .leaderboard-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
    }

    .lb-th-rank {
        padding: 0.75rem 0.75rem;
        text-align: center;
        width: 56px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .lb-th-model {
        padding: 0.75rem 1rem;
        text-align: left;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .lb-th-bar {
        padding: 0.75rem 1rem;
        text-align: left;
        width: 35%;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .lb-th-score {
        padding: 0.75rem 1rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .lb-th-tier {
        padding: 0.75rem 1rem;
        text-align: center;
        width: 80px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }

    .lb-td-rank {
        padding: 0.875rem 0.75rem;
        text-align: center;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }
    .lb-td-model {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }
    .lb-td-bar {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }
    .lb-td-score {
        padding: 0.875rem 1rem;
        text-align: center;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }
    .lb-td-speed {
        padding: 0.875rem 1rem;
        text-align: center;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }
    .lb-td-tier {
        padding: 0.875rem 1rem;
        text-align: center;
        border-bottom: 1px solid var(--border-subtle);
        vertical-align: middle;
    }

    .leaderboard-table tbody tr {
        transition: background 0.12s ease;
    }
    .leaderboard-table tbody tr:hover {
        background: var(--bg-container-highest);
    }
    .leaderboard-table .lb-row-podium {
        background: rgba(173, 198, 255, 0.03);
    }

    /* Rank medals */
    .rank-medal {
        font-size: 16px;
        font-weight: 700;
        font-family: var(--font-mono);
    }
    .rank-gold {
        color: #fbbf24;
        text-shadow: 0 0 8px rgba(251, 191, 36, 0.3);
    }
    .rank-silver {
        color: #c2c6d6;
    }
    .rank-bronze {
        color: #d4a574;
    }

    /* Model cell */
    .lb-model-cell {
        display: flex;
        flex-direction: column;
    }
    .lb-model-name-row {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .lb-model-link {
        font-family: var(--font-ui);
        font-weight: 600;
        color: var(--text-primary);
        transition: color 0.15s;
    }
    .lb-model-link:hover {
        color: var(--brand-primary);
    }
    .lb-trace-link {
        display: inline-flex;
        align-items: center;
        color: var(--text-tertiary);
        transition: color 0.15s;
    }
    .lb-trace-link:hover {
        color: var(--brand-primary);
    }
    .lb-trace-icon {
        font-size: 16px !important;
    }
    .lb-model-sub {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
    }

    /* Progress bar */
    .lb-bar-container {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .lb-bar-label {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        color: var(--brand-primary);
    }
    .lb-bar-track {
        width: 100%;
        height: 6px;
        background: var(--bg-container-highest);
        border-radius: 3px;
        overflow: hidden;
    }
    .lb-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.6s ease;
        min-width: 4px;
    }

    /* Score chip */
    .lb-score-chip {
        display: inline-block;
        padding: 1px 8px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 500;
        background: rgba(78, 222, 163, 0.08);
        color: var(--success);
    }

    /* Speed */
    .lb-speed-value {
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }
    .lb-speed-unit {
        display: block;
        font-family: var(--font-mono);
        font-size: 9px;
        color: var(--text-tertiary);
        text-transform: uppercase;
    }

    /* Footnote */
    .lb-footnote {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--bg-low);
        border-top: 1px solid var(--border-subtle);
        flex-wrap: wrap;
    }
    .lb-footnote-icon {
        font-size: 14px !important;
        color: var(--success);
    }
    .lb-footnote-text {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-secondary);
    }

    /* ═══════════════════════════════════════════════════════════════
     PROMPT PACKS REGISTRY
     ═══════════════════════════════════════════════════════════════ */

    .packs-layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    /* Filter sidebar */
    .packs-sidebar {
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        position: sticky;
        top: calc(var(--topbar-h) + 1.5rem);
    }
    .packs-filter-section {
        margin-bottom: 1.25rem;
    }
    .packs-filter-section:last-of-type {
        margin-bottom: 1rem;
    }
    .packs-filter-title {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.5rem;
    }
    .packs-filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    .packs-filter-chip {
        padding: 2px 8px;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        color: var(--text-secondary);
        background: transparent;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition: all 0.12s;
        text-transform: capitalize;
    }
    .packs-filter-chip:hover {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .packs-filter-chip-active {
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        border-color: var(--brand-primary);
        font-weight: 600;
    }
    .packs-filter-count {
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-tertiary);
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
    }

    /* Pack cards */
    .packs-content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .pack-card {
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        overflow: hidden;
        transition: border-color 0.15s;
    }
    .pack-card:hover {
        border-color: var(--border-prominent);
    }
    .pack-card-expanded {
        border-color: rgba(173, 198, 255, 0.25);
    }

    .pack-card-header {
        display: flex;
        align-items: flex-start;
        padding: 1.25rem;
        cursor: pointer;
        transition: background 0.12s;
    }
    .pack-card-header:hover {
        background: var(--bg-container-high);
    }
    .pack-card-main {
        flex: 1;
        min-width: 0;
    }
    .pack-card-title-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
    }
    .pack-card-name {
        font-family: var(--font-ui);
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
    }
    .pack-card-version {
        flex-shrink: 0;
    }
    .pack-card-desc {
        font-family: var(--font-ui);
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: 0.75rem;
    }
    .pack-card-stats {
        display: flex;
        gap: 1.25rem;
        margin-bottom: 0.5rem;
    }
    .pack-stat {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-secondary);
    }
    .pack-stat-icon {
        font-size: 14px !important;
        color: var(--text-tertiary);
    }
    .pack-stat-value {
        color: var(--text-primary);
        font-weight: 500;
    }
    .pack-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    .pack-tag {
        padding: 1px 6px;
        background: var(--bg-low);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 9px;
        color: var(--text-tertiary);
        text-transform: uppercase;
    }
    .pack-expand-icon {
        flex-shrink: 0;
        color: var(--text-tertiary);
        font-size: 20px !important;
        transition: transform 0.2s;
    }
    .pack-expand-open {
        transform: rotate(180deg);
    }

    .pack-card-body {
        padding: 0 1.25rem 1.25rem;
        border-top: 1px solid var(--border-subtle);
    }
    .pack-section {
        padding-top: 1.25rem;
    }
    .pack-section-title {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-subtle);
        padding-bottom: 0.5rem;
    }

    .pack-categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.5rem;
    }
    .pack-category-item {
        background: var(--bg-low);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        padding: 0.625rem 0.75rem;
    }
    .pack-cat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.375rem;
    }
    .pack-cat-label {
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-primary);
    }
    .pack-cat-count {
        font-size: 11px;
        color: var(--brand-primary);
        font-weight: 600;
    }
    .pack-cat-diffs {
        display: flex;
        gap: 4px;
    }
    .pack-diff-badge {
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
    }
    .pack-diff-easy {
        background: rgba(78, 222, 163, 0.1);
        color: var(--success);
    }
    .pack-diff-medium {
        background: rgba(251, 191, 36, 0.1);
        color: var(--warning);
    }
    .pack-diff-hard {
        background: rgba(255, 180, 171, 0.1);
        color: var(--error);
    }

    .pack-skills-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .pack-skill-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: var(--bg-low);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
    }
    .pack-skill-name {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-primary);
        background: var(--bg-container-highest);
        padding: 1px 6px;
        border-radius: var(--radius-sm);
    }
    .pack-skill-desc {
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-secondary);
        margin-left: auto;
    }

    .pack-meta-row {
        display: flex;
        gap: 1.5rem;
        margin-top: 1.25rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
    }
    .pack-meta-item {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-tertiary);
    }

    /* ═══════════════════════════════════════════════════════════════
     AGENTIC TRACES EXPLORER
     ═══════════════════════════════════════════════════════════════ */

    .traces-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 0;
        height: calc(100vh - var(--topbar-h) - 5rem);
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    /* Sidebar */
    .traces-sidebar {
        border-right: 1px solid var(--border-default);
        background: var(--bg-low);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .traces-sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-default);
    }
    .traces-filter-icon {
        font-size: 16px !important;
        color: var(--text-tertiary);
        cursor: pointer;
    }
    .traces-filter-icon:hover {
        color: var(--brand-primary);
    }
    .traces-sidebar-actions {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .traces-sidebar-export {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        background: none;
        color: var(--text-tertiary);
        cursor: pointer;
        transition: all 0.12s;
        flex-shrink: 0;
    }
    .traces-sidebar-export:hover {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .traces-sidebar-export .material-symbols-outlined {
        font-size: 14px !important;
    }
    .traces-run-list {
        flex: 1;
        overflow-y: auto;
    }
    .traces-run-item {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        cursor: pointer;
        transition:
            background 0.12s,
            border-color 0.12s;
    }
    .traces-run-item:hover {
        background: var(--bg-container-high);
    }
    .traces-run-active {
        background: var(--bg-container-high);
        border-left: 3px solid var(--brand-primary);
    }
    .traces-run-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.25rem;
    }
    .traces-run-id {
        font-size: 12px;
        font-weight: 600;
        color: var(--brand-primary);
    }
    .traces-run-status {
        font-size: 14px !important;
    }
    .traces-status-completed {
        color: var(--success);
    }
    .traces-status-failed {
        color: var(--error);
    }
    .traces-status-running {
        color: var(--warning);
        animation: spin 2s linear infinite;
    }

    @keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    .traces-run-model {
        font-family: var(--font-ui);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 0.125rem;
    }
    .traces-run-meta {
        display: flex;
        gap: 0.375rem;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
        margin-bottom: 0.25rem;
    }
    .traces-run-time {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
    }

    /* Timeline */
    .traces-timeline {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .traces-timeline-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.5rem;
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .traces-tl-info {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }
    .traces-tl-model {
        font-family: var(--font-ui);
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
    }
    .traces-tl-prompt {
        font-size: 11px;
        color: var(--text-secondary);
    }
    .traces-tl-total {
        text-align: right;
    }
    .traces-tl-actions {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .traces-tl-export {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        background: var(--bg-container);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.12s;
        flex-shrink: 0;
    }
    .traces-tl-export:hover {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .traces-tl-export:active {
        transform: scale(0.94);
    }

    /* ── Copy success toast ─────────────────────────────────── */
    .traces-toast {
        position: absolute;
        top: 0.75rem;
        right: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        background: var(--bg-container-highest);
        border: 1px solid var(--success);
        border-radius: var(--radius-md);
        z-index: 50;
        box-shadow:
            0 0 0 1px rgba(78, 222, 163, 0.15),
            0 8px 24px rgba(10, 14, 30, 0.65);
        animation: toast-in 0.25s ease-out;
    }
    .traces-toast-icon {
        font-size: 16px !important;
        color: var(--success);
    }
    .traces-toast-text {
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 500;
        color: var(--text-primary);
    }
    @keyframes toast-in {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .traces-tl-time {
        display: block;
        font-family: var(--font-mono);
        font-size: 18px;
        font-weight: 700;
        color: var(--success);
        margin-top: 0.125rem;
    }

    /* Steps */
    .traces-steps {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        scroll-behavior: smooth;
    }
    .traces-step {
        display: flex;
        gap: 1rem;
        position: relative;
    }
    .traces-step:last-child {
        padding-bottom: 0;
    }
    .traces-step-hovered .traces-step-content {
        background: var(--bg-container-high);
    }
    .traces-step-current .traces-step-content {
        background: var(--bg-container-high);
        border-color: var(--brand-primary);
        box-shadow:
            0 0 0 1px rgba(173, 198, 255, 0.15),
            inset 0 0 20px rgba(173, 198, 255, 0.04);
    }

    /* Flash pulse: one-shot highlight on step arrival */
    .traces-step-flash .traces-step-content {
        animation: step-arrive-flash 0.6s ease-out forwards;
    }

    /* Slide transition: step card slides in from left or right */
    .traces-step-slide-right {
        animation: slide-in-right 0.3s ease-out;
    }
    .traces-step-slide-left {
        animation: slide-in-left 0.3s ease-out;
    }
    @keyframes slide-in-right {
        from {
            opacity: 0.5;
            transform: translateX(16px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    @keyframes slide-in-left {
        from {
            opacity: 0.5;
            transform: translateX(-16px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes step-arrive-flash {
        0% {
            box-shadow:
                0 0 0 0 rgba(173, 198, 255, 0),
                inset 0 0 0 rgba(173, 198, 255, 0);
            background: var(--bg-container);
        }
        15% {
            box-shadow:
                0 0 0 3px rgba(173, 198, 255, 0.3),
                inset 0 0 30px rgba(173, 198, 255, 0.08);
            background: rgba(173, 198, 255, 0.06);
        }
        100% {
            box-shadow:
                0 0 0 1px rgba(173, 198, 255, 0.15),
                inset 0 0 20px rgba(173, 198, 255, 0.04);
            background: var(--bg-container-high);
        }
    }

    /* Timeline gutter */
    .traces-step-gutter {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 18px;
        flex-shrink: 0;
        position: relative;
        padding-top: 4px;
    }
    .traces-step-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        z-index: 1;
        flex-shrink: 0;
        box-shadow: 0 0 6px rgba(0, 0, 0, 0.3);
        will-change: transform;
        transition: box-shadow 0.15s ease;
    }
    /* Alternating parallax drift: odd dots move opposite direction to even ones */
    .traces-step:nth-child(odd) .traces-step-dot {
        transform: translateY(calc(var(--steps-scroll-y, 0px) * -0.012));
    }
    .traces-step:nth-child(even) .traces-step-dot {
        transform: translateY(calc(var(--steps-scroll-y, 0px) * 0.01));
    }
    .traces-step-dot-pulse {
        transform: translateY(calc(var(--steps-scroll-y, 0px) * -0.012))
            scale(1.5);
        box-shadow:
            0 0 0 3px rgba(173, 198, 255, 0.2),
            0 0 12px rgba(173, 198, 255, 0.25),
            0 0 6px rgba(0, 0, 0, 0.3);
        animation: dot-play-pulse 0.8s ease-in-out infinite;
    }
    /* Preserve even-parity parallax during playback pulse */
    .traces-step:nth-child(even) .traces-step-dot-pulse {
        transform: translateY(calc(var(--steps-scroll-y, 0px) * 0.01))
            scale(1.5);
    }
    @keyframes dot-play-pulse {
        0%,
        100% {
            box-shadow:
                0 0 0 3px rgba(173, 198, 255, 0.2),
                0 0 12px rgba(173, 198, 255, 0.25),
                0 0 6px rgba(0, 0, 0, 0.3);
        }
        50% {
            box-shadow:
                0 0 0 6px rgba(173, 198, 255, 0.08),
                0 0 20px rgba(173, 198, 255, 0.15),
                0 0 6px rgba(0, 0, 0, 0.3);
        }
    }
    .traces-step-line {
        width: 1px;
        flex: 1;
        background: var(--border-default);
        min-height: 1.5rem;
        margin-top: 4px;
        margin-bottom: 4px;
    }

    .traces-step-content {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        margin-bottom: 0.5rem;
        transition:
            background 0.12s,
            border-color 0.12s,
            box-shadow 0.2s ease;
    }
    .traces-step-hovered .traces-step-content {
        border-color: var(--border-prominent);
    }
    .traces-step-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .traces-step-icon {
        font-size: 16px !important;
    }
    .traces-step-type-chip {
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        border: 1px solid;
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
    }
    .traces-step-label {
        font-family: var(--font-ui);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
        flex: 1;
    }
    .traces-step-time {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-tertiary);
    }
    .traces-step-detail {
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-top: 0.375rem;
    }

    /* Tool detail */
    .traces-tool-detail {
        margin-top: 0.5rem;
        padding: 0.625rem;
        background: var(--bg-lowest);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
    }
    .traces-tool-header {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        margin-bottom: 0.375rem;
    }
    .traces-tool-name {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--brand-primary);
    }
    .traces-tool-input {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-secondary);
        background: transparent;
        white-space: pre-wrap;
    }

    /* Response preview */
    .traces-response-preview {
        margin-top: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(78, 222, 163, 0.06);
        border-left: 2px solid var(--success);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-secondary);
    }

    /* Diff lines */
    .diff-added {
        background-color: rgba(78, 222, 163, 0.1);
        border-left: 2px solid var(--success);
        padding: 2px 8px;
        font-family: var(--font-mono);
        font-size: 13px;
    }
    .diff-removed {
        background-color: rgba(255, 180, 171, 0.1);
        border-left: 2px solid var(--error);
        padding: 2px 8px;
        font-family: var(--font-mono);
        font-size: 13px;
    }

    /* Playback controls */
    .traces-playback {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-top: 1px solid var(--border-default);
        background: var(--bg-low);
    }
    .traces-pb-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        background: var(--bg-container);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.12s;
    }
    .traces-pb-btn:hover {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .traces-pb-play {
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        border-color: var(--brand-primary);
    }
    .traces-pb-pause {
        background: var(--warning);
        color: var(--warning-container);
        border-color: var(--warning);
        animation: pulse-pause 1.5s ease-in-out infinite;
    }
    @keyframes pulse-pause {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.3);
        }
        50% {
            box-shadow: 0 0 0 4px rgba(251, 191, 36, 0);
        }
    }
    .traces-pb-speed {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
    }
    .traces-pb-divider {
        width: 1px;
        height: 20px;
        background: var(--border-default);
        margin: 0 0.25rem;
    }
    .traces-pb-progress {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .traces-pb-track {
        flex: 1;
        height: 4px;
        background: var(--bg-container-highest);
        border-radius: 2px;
        overflow: visible;
        cursor: pointer;
        position: relative;
        transition: height 0.12s ease;
    }
    .traces-pb-scrubbing .traces-pb-track,
    .traces-pb-track:hover {
        height: 6px;
    }
    .traces-pb-fill {
        height: 100%;
        border-radius: 2px;
        background: var(--brand-primary);
        transition: width 0.1s linear;
        pointer-events: none;
    }
    .traces-pb-thumb {
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--brand-primary);
        border: 2px solid var(--bg-container);
        box-shadow: 0 0 0 2px rgba(173, 198, 255, 0.2);
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 0.12s ease,
            box-shadow 0.15s ease;
        z-index: 2;
    }
    .traces-pb-scrubbing .traces-pb-thumb,
    .traces-pb-track:hover .traces-pb-thumb {
        opacity: 1;
        box-shadow: 0 0 0 3px rgba(173, 198, 255, 0.3);
    }
    .traces-pb-scrubbing .traces-pb-thumb {
        box-shadow:
            0 0 0 4px rgba(173, 198, 255, 0.35),
            0 0 8px rgba(173, 198, 255, 0.2);
    }
    .traces-pb-time {
        font-size: 11px;
        color: var(--text-tertiary);
    }

    /* Help button (?) to reveal keyboard shortcuts */
    .traces-pb-help {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-full);
        background: none;
        color: var(--text-tertiary);
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
        margin-left: 0.25rem;
        flex-shrink: 0;
    }
    .traces-pb-help:hover {
        border-color: var(--brand-primary);
        color: var(--brand-primary);
        background: rgba(173, 198, 255, 0.06);
    }
    .traces-pb-help:active {
        transform: scale(0.92);
    }

    /* ── Keyboard Shortcuts Overlay ─────────────────────────── */
    .traces-shortcuts-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 99;
        animation: shortcuts-fade-in 0.15s ease-out;
    }
    .traces-shortcuts-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: var(--bg-container-highest);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        min-width: 340px;
        z-index: 100;
        box-shadow:
            0 0 0 1px rgba(173, 198, 255, 0.1),
            0 16px 48px rgba(10, 14, 30, 0.75);
        animation: shortcuts-slide-in 0.2s ease-out;
    }
    @keyframes shortcuts-fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes shortcuts-slide-in {
        from {
            opacity: 0;
            transform: translate(-50%, -48%);
        }
        to {
            opacity: 1;
            transform: translate(-50%, -50%);
        }
    }
    .traces-shortcuts-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    .traces-shortcuts-title {
        font-family: var(--font-ui);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }
    .traces-shortcuts-close {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        color: var(--text-tertiary);
        cursor: pointer;
        transition:
            border-color 0.12s,
            color 0.12s;
    }
    .traces-shortcuts-close:hover {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .traces-shortcuts-grid {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .traces-shortcut-row {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .traces-shortcut-desc {
        font-family: var(--font-ui);
        font-size: 13px;
        color: var(--text-secondary);
    }
    .traces-kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 24px;
        padding: 0 6px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--text-primary);
        background: var(--bg-low);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        box-shadow: 0 1px 0 var(--border-prominent);
    }
    .traces-kbd-inline {
        display: inline-flex;
        min-width: auto;
        height: 18px;
        padding: 0 4px;
        font-size: 10px;
        vertical-align: middle;
    }
    .traces-kbd-group {
        display: flex;
        gap: 0.25rem;
    }
    .traces-shortcuts-footer {
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
    }
    .traces-shortcuts-hint {
        font-family: var(--font-ui);
        font-size: 11px;
        color: var(--text-tertiary);
    }

    /* ── Playground View Trace button ────────────────────────── */
    .pg-results-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    .pg-results-header h3 {
        margin: 0;
    }

    /* ── Trace filter input (sidebar) ───────────────────────── */
    .traces-filter {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border-default);
        position: relative;
    }
    .traces-filter-search-icon {
        position: absolute;
        left: 0.875rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px !important;
        color: var(--text-tertiary);
        pointer-events: none;
        z-index: 1;
    }
    .traces-filter-input {
        flex: 1;
        background: var(--bg-lowest);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        padding: 0.375rem 1.75rem 0.375rem 1.75rem;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-primary);
        outline: none;
        transition: border-color 0.15s;
    }
    .traces-filter-input:focus {
        border-color: var(--brand-primary);
    }
    .traces-filter-input::placeholder {
        color: var(--text-tertiary);
    }
    .traces-filter-clear {
        position: absolute;
        right: 0.875rem;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        color: var(--text-tertiary);
        cursor: pointer;
        z-index: 1;
        padding: 0;
    }
    .traces-filter-clear:hover {
        color: var(--text-primary);
    }
    .traces-filter-clear .material-symbols-outlined {
        font-size: 14px !important;
    }
    .traces-filter-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem 1rem;
        color: var(--text-tertiary);
        font-size: 12px;
    }
    .traces-filter-empty .material-symbols-outlined {
        font-size: 24px !important;
    }
    .pg-view-trace-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        border: 1px solid var(--brand-primary);
        border-radius: var(--radius-md);
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition:
            opacity 0.12s,
            transform 0.1s;
        flex-shrink: 0;
    }
    .pg-view-trace-btn:hover {
        opacity: 0.9;
    }
    .pg-view-trace-btn:active {
        transform: scale(0.97);
    }
    .pg-view-trace-btn .material-symbols-outlined {
        font-size: 14px !important;
    }

    /* ═══════════════════════════════════════════════════════════════
     REPLAY TOAST
     ═══════════════════════════════════════════════════════════════ */

    .rpv-toast {
        position: fixed;
        bottom: 1.5rem;
        left: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 1rem;
        background: var(--bg-container-highest);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-lg);
        z-index: 60;
        text-decoration: none;
        color: inherit;
        box-shadow:
            0 0 0 1px rgba(173, 198, 255, 0.08),
            0 8px 24px rgba(0, 0, 0, 0.4);
        animation: rpv-toast-in 0.3s ease-out;
        transition:
            border-color 0.15s ease,
            box-shadow 0.15s ease;
        max-width: 360px;
        cursor: pointer;
    }
    .rpv-toast:hover {
        border-color: var(--brand-primary);
        box-shadow:
            0 0 0 1px rgba(173, 198, 255, 0.2),
            0 8px 28px rgba(0, 0, 0, 0.45);
    }
    .rpv-toast-success {
        border-color: rgba(78, 222, 163, 0.3);
    }
    .rpv-toast-success:hover {
        border-color: var(--success);
    }
    .rpv-toast-error {
        border-color: rgba(255, 180, 171, 0.3);
    }
    .rpv-toast-error:hover {
        border-color: var(--error);
    }

    @keyframes rpv-toast-in {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .rpv-toast-icon-col {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .rpv-toast-icon-col .material-symbols-outlined {
        font-size: 22px !important;
    }
    .rpv-toast-success .rpv-toast-icon-col .material-symbols-outlined {
        color: var(--success);
    }
    .rpv-toast-error .rpv-toast-icon-col .material-symbols-outlined {
        color: var(--error);
    }

    .rpv-toast-body {
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
        flex: 1;
    }
    .rpv-toast-title {
        font-family: var(--font-ui);
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
    }
    .rpv-toast-desc {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-secondary);
        line-height: 1.4;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .rpv-toast-desc strong {
        color: var(--brand-primary);
        font-weight: 600;
    }

    .rpv-toast-arrow {
        font-size: 16px !important;
        color: var(--text-tertiary);
        flex-shrink: 0;
        transition: transform 0.15s ease;
    }
    .rpv-toast:hover .rpv-toast-arrow {
        transform: translateX(2px);
    }

    /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE — Mobile & Tablet
     ═══════════════════════════════════════════════════════════════ */

    /* Hidden checkbox for menu toggle */
    .menu-toggle-input {
        display: none;
    }

    /* Hamburger button (hidden on desktop) */
    .hamburger-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition:
            background 0.15s,
            border-color 0.15s;
        flex-shrink: 0;
    }
    .hamburger-btn:hover {
        background: var(--bg-container-high);
        border-color: var(--border-prominent);
    }
    .hamburger-icon {
        font-size: 18px !important;
        color: var(--text-secondary);
    }
    .hamburger-close {
        display: none;
    }

    /* Mobile overlay backdrop */
    .menu-backdrop {
        display: block !important;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 45;
        opacity: 0;
        transition: opacity 0.25s ease;
        pointer-events: none;
    }

    @media (max-width: 1024px) {
        /* ── Sidebar overlay on tablet/mobile ─────────────────── */
        .sidebar {
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            will-change: transform;
            z-index: 55;
        }

        .menu-toggle-input:checked ~ .sidebar {
            transform: translateX(0);
        }

        .menu-toggle-input:checked ~ .topbar .hamburger-open {
            display: none;
        }
        .menu-toggle-input:checked ~ .topbar .hamburger-close {
            display: inline-flex;
        }

        .menu-toggle-input:checked ~ .menu-backdrop {
            display: block;
            opacity: 1;
            pointer-events: auto;
        }

        /* Hamburger visible */
        .hamburger-btn {
            display: inline-flex;
        }

        /* Topbar spans full width */
        .topbar {
            width: 100%;
            left: 0;
        }

        /* Main canvas fills full width */
        .main-canvas {
            margin-left: 0;
        }

        /* ── Dashboard header stacks vertically ─────────────── */
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }
        .dashboard-header .dashboard-actions {
            width: 100%;
        }

        /* ── Grids collapse to single column ────────────────── */
        .dashboard-charts {
            grid-template-columns: 1fr;
        }
        .dashboard-resources {
            grid-template-columns: 1fr;
        }
        .grid-2 {
            grid-template-columns: 1fr;
        }
        .grid-3 {
            grid-template-columns: 1fr;
        }
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }
        .trace-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .meta-grid {
            grid-template-columns: 1fr;
        }
        .perf-group {
            grid-template-columns: 1fr;
        }

        /* ── Side-by-side layouts collapse ───────────────────── */
        .packs-layout {
            grid-template-columns: 1fr;
        }
        .packs-sidebar {
            position: static;
        }
        .traces-layout {
            grid-template-columns: 1fr;
            height: auto;
            max-height: none;
        }
        .rpv-layout {
            grid-template-columns: 1fr;
            height: auto;
            max-height: none;
        }
        .sg-layout {
            grid-template-columns: 1fr;
        }
        .sg-sidebar {
            position: static;
        }
        .methodology-grid {
            grid-template-columns: 1fr;
        }

        /* ── Cards reduce padding ───────────────────────────── */
        .card {
            padding: 1rem;
        }
        .chart-card {
            padding: 1rem;
        }
    }

    @media (max-width: 640px) {
        /* ── Topbar: badges stack vertically ───────────────── */
        .topbar {
            flex-wrap: wrap;
            height: auto;
            min-height: var(--topbar-h);
            padding: 0.5rem var(--container-pad);
            gap: 0.5rem;
        }
        .topbar-left {
            width: 100%;
            justify-content: space-between;
        }
        .topbar-right {
            width: 100%;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 0.5rem;
        }

        /* Search shrinks */
        .search-input {
            width: 12rem;
        }
        .search-wrapper {
            flex: 1;
        }
        .search-input {
            width: 100%;
        }

        /* Hardware badge becomes compact */
        .hardware-badge .hw-label {
            font-size: 10px;
        }

        /* Connection hint hidden on very small screens */
        .connection-hint {
            display: none;
        }

        /* Main content reduces padding */
        .main-canvas {
            padding: calc(var(--topbar-h) + 1rem) 0.75rem 4rem;
            padding-top: calc(var(--topbar-h) * 2 + 0.5rem);
        }

        /* ── Stack grids ───────────────────────────────────── */
        .stats-grid {
            grid-template-columns: 1fr;
        }
        .trace-stats-grid {
            grid-template-columns: 1fr 1fr;
        }
        .pack-categories-grid {
            grid-template-columns: 1fr;
        }

        /* ── Leaderboard/snapshot card sizing ─────────────── */
        .sg-grid {
            grid-template-columns: 1fr;
        }

        /* ── Modal full width on mobile ────────────────────── */
        .modal-dialog {
            width: 96vw;
            max-height: 90vh;
        }

        /* ── Breadcrumb headers tighten ────────────────────── */
        .dashboard-title {
            font-size: 20px;
            line-height: 28px;
        }
        .section-header h2 {
            font-size: 20px;
        }

        /* ── Connection badge compact ───────────────────────── */
        .connection-label {
            font-size: 10px;
        }
        .connection-badge {
            padding: 0.2rem 0.5rem;
        }

        /* ── Floated items reposition ─────────────────────── */
        .node-status {
            bottom: 0.75rem;
            right: 0.75rem;
            padding: 0.375rem 0.75rem;
        }
        .rpv-toast {
            left: 0.75rem;
            bottom: 0.75rem;
            max-width: calc(100vw - 1.5rem);
        }
    }

    /* ═══════════════════════════════════════════════════════════════
     REPLAY SIDEBAR BADGE
     ═══════════════════════════════════════════════════════════════ */

    .sidebar-link-label {
        flex: 1;
    }
    .rpv-sidebar-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: var(--radius-full);
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        flex-shrink: 0;
        animation: rpv-badge-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes rpv-badge-pop {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        60% {
            transform: scale(1.2);
            opacity: 1;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* ═══════════════════════════════════════════════════════════════
     REPLAY VIEWER
     ═══════════════════════════════════════════════════════════════ */

    .rpv-layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 0;
        height: calc(100vh - var(--topbar-h) - 5rem);
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    /* ── Sidebar ─────────────────────────────────────────────── */
    .rpv-sidebar {
        border-right: 1px solid var(--border-default);
        background: var(--bg-low);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .rpv-sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-default);
    }
    .rpv-sidebar-header .mono-label {
        font-size: 10px;
    }
    .rpv-sidebar-count {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--brand-primary);
        background: rgba(173, 198, 255, 0.1);
        padding: 1px 7px;
        border-radius: var(--radius-sm);
    }
    .rpv-sidebar-list {
        flex: 1;
        overflow-y: auto;
    }
    .rpv-sidebar-loading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1.5rem 1rem;
        font-size: 12px;
        color: var(--text-tertiary);
    }
    .rpv-spin {
        animation: spin 1s linear infinite;
    }
    .rpv-sidebar-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem 1rem;
        color: var(--text-tertiary);
        font-size: 12px;
        text-align: center;
    }
    .rpv-sidebar-empty .material-symbols-outlined {
        font-size: 24px !important;
        opacity: 0.5;
    }
    .rpv-sidebar-hint {
        font-size: 11px;
        opacity: 0.7;
        line-height: 1.4;
    }
    .rpv-sidebar-hint code {
        font-family: var(--font-mono);
        background: rgba(255, 255, 255, 0.04);
        padding: 1px 4px;
        border-radius: 2px;
        font-size: 10px;
    }

    /* Sidebar item */
    .rpv-sidebar-item {
        padding: 0.625rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        cursor: pointer;
        transition: background 0.12s;
    }
    .rpv-sidebar-item:hover {
        background: var(--bg-container-high);
    }
    .rpv-sidebar-active {
        background: var(--bg-container-high);
        border-left: 3px solid var(--brand-primary);
    }
    .rpv-sidebar-item-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.125rem;
    }
    .rpv-sidebar-model {
        font-family: var(--font-ui);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
    }
    .rpv-sidebar-events {
        font-size: 10px;
        color: var(--text-tertiary);
    }
    .rpv-sidebar-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.125rem;
    }
    .rpv-sidebar-workload {
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 500;
        color: var(--text-tertiary);
        background: var(--bg-container);
        padding: 1px 5px;
        border-radius: var(--radius-sm);
        text-transform: uppercase;
    }
    .rpv-sidebar-time {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-tertiary);
    }

    /* ── Main area ───────────────────────────────────────────── */
    .rpv-main {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

    /* Error banner */
    .rpv-error-banner {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        padding: 0.625rem 1rem;
        background: rgba(255, 180, 171, 0.06);
        border-bottom: 1px solid rgba(255, 180, 171, 0.15);
        font-size: 12px;
        color: var(--text-secondary);
    }
    .rpv-error-banner .material-symbols-outlined {
        font-size: 18px !important;
        color: var(--error);
        flex-shrink: 0;
        margin-top: 1px;
    }
    .rpv-error-dismiss {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        padding: 0;
        margin-left: auto;
        background: none;
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        color: var(--text-tertiary);
        cursor: pointer;
        flex-shrink: 0;
        transition: all 0.12s;
    }
    .rpv-error-dismiss:hover {
        border-color: var(--border-default);
        color: var(--text-primary);
    }
    .rpv-error-dismiss .material-symbols-outlined {
        font-size: 14px !important;
        color: inherit;
    }

    /* Loading / empty states */
    .rpv-loading-detail {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        flex: 1;
        font-size: 13px;
        color: var(--text-tertiary);
    }
    .rpv-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        flex: 1;
        color: var(--text-tertiary);
        font-size: 13px;
        text-align: center;
        padding: 2rem;
    }
    .rpv-empty-icon {
        font-size: 32px !important;
        opacity: 0.4;
    }

    /* ── Header ──────────────────────────────────────────────── */
    .rpv-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--border-default);
        background: var(--bg-low);
    }
    .rpv-header-left {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .rpv-model-name {
        font-family: var(--font-ui);
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
    }
    .rpv-header-meta {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        flex-wrap: wrap;
    }
    .rpv-meta-chip {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        color: var(--brand-primary);
        background: rgba(173, 198, 255, 0.1);
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        text-transform: uppercase;
    }
    .rpv-meta-divider {
        color: var(--border-default);
        font-size: 12px;
    }
    .rpv-header-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.125rem;
    }
    .rpv-header-right .mono-label {
        font-size: 9px;
    }
    .rpv-header-time {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-secondary);
    }

    /* ── Event Timeline ──────────────────────────────────────── */
    .rpv-event-list {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem 0.75rem 0.5rem;
        scroll-behavior: smooth;
    }
    .rpv-event {
        display: flex;
        gap: 0.75rem;
        cursor: pointer;
        transition: opacity 0.1s;
    }
    .rpv-event:hover {
        opacity: 0.95;
    }

    /* Gutter (dot + connecting line) */
    .rpv-event-gutter {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 16px;
        flex-shrink: 0;
        padding-top: 6px;
    }
    .rpv-event-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        z-index: 1;
        flex-shrink: 0;
        box-shadow: 0 0 6px rgba(0, 0, 0, 0.3);
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }
    .rpv-dot-pulse {
        transform: scale(1.6);
        box-shadow:
            0 0 0 3px rgba(173, 198, 255, 0.15),
            0 0 12px rgba(173, 198, 255, 0.2);
        animation: rpv-dot-play-pulse 0.8s ease-in-out infinite;
    }
    @keyframes rpv-dot-play-pulse {
        0%,
        100% {
            box-shadow:
                0 0 0 3px rgba(173, 198, 255, 0.15),
                0 0 12px rgba(173, 198, 255, 0.2);
        }
        50% {
            box-shadow:
                0 0 0 6px rgba(173, 198, 255, 0.06),
                0 0 20px rgba(173, 198, 255, 0.12);
        }
    }
    .rpv-event-line {
        width: 1px;
        flex: 1;
        background: var(--border-default);
        min-height: 1.25rem;
        margin-top: 4px;
    }

    /* Event card */
    .rpv-event-card {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        margin-bottom: 0.5rem;
        background: var(--bg-low);
        transition:
            background 0.12s,
            border-color 0.12s,
            box-shadow 0.2s ease;
        min-width: 0;
    }
    .rpv-event-current .rpv-event-card {
        background: var(--bg-container-high);
        border-color: var(--brand-primary);
        box-shadow:
            0 0 0 1px rgba(173, 198, 255, 0.12),
            inset 0 0 20px rgba(173, 198, 255, 0.03);
    }
    .rpv-event-hovered .rpv-event-card {
        border-color: var(--border-prominent);
    }

    .rpv-event-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .rpv-event-type-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 1px 7px;
        border-radius: var(--radius-sm);
        border: 1px solid;
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .rpv-event-chip-icon {
        font-size: 12px !important;
    }
    .rpv-event-index {
        font-size: 10px;
        color: var(--text-tertiary);
        margin-left: auto;
    }
    .rpv-event-detail {
        margin-top: 0.375rem;
        font-family: var(--font-ui);
        font-size: 12px;
        color: var(--text-secondary);
        line-height: 1.5;
    }

    /* Detail value styles */
    .rpv-detail-token {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-primary);
        word-break: break-word;
    }
    .rpv-detail-mono {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-primary);
    }
    .rpv-detail-mono strong {
        color: var(--brand-primary);
    }
    .rpv-detail-error {
        color: var(--error);
    }

    /* ── Playback Controls ───────────────────────────────────── */
    .rpv-playback {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1rem;
        border-top: 1px solid var(--border-default);
        background: var(--bg-low);
    }
    .rpv-pb-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        background: var(--bg-container);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.12s;
        flex-shrink: 0;
    }
    .rpv-pb-btn:hover:not(:disabled) {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .rpv-pb-btn:disabled {
        opacity: 0.4;
        cursor: default;
    }
    .rpv-pb-btn .material-symbols-outlined {
        font-size: 18px !important;
    }
    .rpv-pb-play {
        background: var(--brand-primary);
        color: var(--brand-on-primary);
        border-color: var(--brand-primary);
    }
    .rpv-pb-play:hover:not(:disabled) {
        background: var(--accent-fixed);
        border-color: var(--accent-fixed);
        color: var(--brand-on-primary);
    }
    .rpv-pb-pause {
        background: var(--warning);
        color: var(--warning-container);
        border-color: var(--warning);
        animation: rpv-pause-pulse 1.5s ease-in-out infinite;
    }
    .rpv-pb-pause:hover:not(:disabled) {
        background: #fcd34d;
        color: var(--warning-container);
        border-color: #fcd34d;
    }
    @keyframes rpv-pause-pulse {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.3);
        }
        50% {
            box-shadow: 0 0 0 4px rgba(251, 191, 36, 0);
        }
    }
    .rpv-pb-speed {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
    }
    .rpv-pb-divider {
        width: 1px;
        height: 20px;
        background: var(--border-default);
        margin: 0 0.25rem;
    }
    .rpv-pb-progress {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .rpv-pb-track {
        flex: 1;
        height: 4px;
        background: var(--bg-container-highest);
        border-radius: 2px;
        overflow: visible;
        cursor: pointer;
        position: relative;
        transition: height 0.12s ease;
    }
    .rpv-pb-scrubbing .rpv-pb-track,
    .rpv-pb-track:hover {
        height: 6px;
    }
    .rpv-pb-fill {
        height: 100%;
        border-radius: 2px;
        background: var(--brand-primary);
        transition: width 0.1s linear;
        pointer-events: none;
    }
    .rpv-pb-thumb {
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--brand-primary);
        border: 2px solid var(--bg-container);
        box-shadow: 0 0 0 2px rgba(173, 198, 255, 0.2);
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 0.12s ease,
            box-shadow 0.15s ease;
        z-index: 2;
    }
    .rpv-pb-scrubbing .rpv-pb-thumb,
    .rpv-pb-track:hover .rpv-pb-thumb {
        opacity: 1;
        box-shadow: 0 0 0 3px rgba(173, 198, 255, 0.3);
    }
    .rpv-pb-scrubbing .rpv-pb-thumb {
        box-shadow:
            0 0 0 4px rgba(173, 198, 255, 0.35),
            0 0 8px rgba(173, 198, 255, 0.2);
    }
    .rpv-pb-label {
        font-size: 11px;
        color: var(--text-tertiary);
        white-space: nowrap;
    }

    /* ═══════════════════════════════════════════════════════════════
     LIVE BENCHMARK STATUS PANEL
     ═══════════════════════════════════════════════════════════════ */
    .live-benchmark-panel {
        background: var(--bg-container);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .live-benchmark-panel .lbp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-default);
    }
    .live-benchmark-panel .lbp-header-left {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }
    .live-benchmark-panel .lbp-header-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .live-benchmark-panel .lbp-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        animation: pulse-dot 2s ease-in-out infinite;
    }
    .live-benchmark-panel .lbp-header-info {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }
    .live-benchmark-panel .lbp-model-name {
        font-family: var(--font-ui);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
    }
    .live-benchmark-panel .lbp-status-label {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .live-benchmark-panel .lbp-event-count {
        font-size: 10px;
        color: var(--text-tertiary);
    }
    .live-benchmark-panel .lbp-clear-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        padding: 0;
        background: none;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        color: var(--text-tertiary);
        cursor: pointer;
        transition: all 0.12s;
    }
    .live-benchmark-panel .lbp-clear-btn:hover {
        border-color: var(--text-tertiary);
        color: var(--text-primary);
    }
    .live-benchmark-panel .lbp-clear-btn .material-symbols-outlined {
        font-size: 14px !important;
    }

    /* Metrics row */
    .live-benchmark-panel .lbp-metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--border-subtle);
        border-bottom: 1px solid var(--border-default);
    }
    .live-benchmark-panel .lbp-metric-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0.75rem 0.5rem;
        background: var(--bg-container);
        text-align: center;
    }
    .live-benchmark-panel .lbp-metric-label {
        font-size: 9px;
        color: var(--text-tertiary);
    }
    .live-benchmark-panel .lbp-metric-value {
        font-family: var(--font-mono);
        font-size: 18px;
        font-weight: 700;
        color: var(--text-tertiary);
        line-height: 1.2;
        transition: color 0.2s ease;
    }
    .live-benchmark-panel .lbp-metric-active {
        color: var(--text-primary);
    }
    .live-benchmark-panel .lbp-metric-card:first-child .lbp-metric-active {
        color: var(--brand-primary);
    }
    .live-benchmark-panel .lbp-metric-card:nth-child(2) .lbp-metric-active {
        color: var(--success);
    }
    .live-benchmark-panel .lbp-metric-card:nth-child(3) .lbp-metric-active {
        color: var(--tertiary);
    }
    .live-benchmark-panel .lbp-metric-card:nth-child(4) .lbp-metric-active {
        color: var(--warning);
    }

    /* Token stream */
    .live-benchmark-panel .lbp-token-stream {
        border-bottom: 1px solid var(--border-default);
    }
    .live-benchmark-panel .lbp-token-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 1rem;
        background: var(--bg-low);
        border-bottom: 1px solid var(--border-subtle);
    }
    .live-benchmark-panel .lbp-token-header .mono-label {
        font-size: 10px;
    }
    .live-benchmark-panel .lbp-token-count {
        font-family: var(--font-mono);
