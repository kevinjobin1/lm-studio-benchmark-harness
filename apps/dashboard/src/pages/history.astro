---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadResults } from "../lib/loadResults";
import { loadTraceManifest } from "../lib/loadTraces";
import { loadSnapshotManifest } from "../lib/loadSnapshots";
import type { BenchmarkResult } from "../lib/loadResults";

const results: BenchmarkResult[] = await loadResults();

// Sort by timestamp descending
const sortedRuns = [...results].sort(
    (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime(),
);

// ── Load trace manifest (V2) and build model→trace-count lookup ─
let modelTraceCounts: Map<string, number> = new Map();
let totalTracedRuns = 0;
try {
  const manifest = await loadTraceManifest();
  for (const entry of manifest.traces) {
    const count = modelTraceCounts.get(entry.model) || 0;
    modelTraceCounts.set(entry.model, count + 1);
    totalTracedRuns++;
  }
} catch {
  // Traces not available
}

// ── Load snapshot manifest and build model→snapshot-count lookup ─
let modelSnapshotCounts: Map<string, number> = new Map();
let totalSnapshots = 0;
try {
  const snapManifest = await loadSnapshotManifest();
  for (const entry of snapManifest.snapshots) {
    const count = modelSnapshotCounts.get(entry.model) || 0;
    modelSnapshotCounts.set(entry.model, count + 1);
    totalSnapshots++;
  }
} catch {
  // Snapshots not available
}
---

<BaseLayout
    title="Runs History"
    description="Benchmark run history — review past executions, scores, and timestamps."
    activeNav="history"
>
    <!-- ═══ Page Header ═══════════════════════════════════════════ -->
    <div class="dashboard-header animate-entrance">
        <div>
            <h2 class="dashboard-title">Runs History</h2>
            <p class="dashboard-subtitle">
                {
                    results.length > 0
                        ? `All ${results.length} benchmark runs across ${new Set(results.map((r) => r.model)).size} models.${totalTracedRuns > 0 ? ` ${totalTracedRuns} execution traces captured.` : ""}`
                        : "No benchmark runs recorded yet."
                }
            </p>
        </div>
        <div class="dashboard-actions">
            <button class="btn-outline btn-disabled" disabled aria-disabled="true" title="Refresh — coming soon">
                <span class="material-symbols-outlined icon-18"
                    >refresh</span
                >
                <span>Refresh</span>
            </button>
            <button class="btn-outline btn-disabled" disabled aria-disabled="true" title="Export CSV — coming soon">
                <span class="material-symbols-outlined icon-18"
                    >file_download</span
                >
                <span>Export CSV</span>
            </button>
        </div>
    </div>

    {
        results.length === 0 ? (
            <div class="empty-state">
                <span class="material-symbols-outlined empty-state-icon">history</span>
                <h3>No benchmark history yet</h3>
                <p class="text-balance">
                    Run the benchmark suite to start tracking performance over time.
                </p>
            </div>
        ) : (
            <section class="dashboard-table">
                <div class="card table-card">
                    <div class="table-header">
                        <h3>Run History</h3>
                    </div>
                    <div class="model-table-wrapper">
                        <table class="model-table">
                            <thead>
                                <tr>
                                    <th class="th-model">Run</th>
                                    <th class="th-model">Model</th>
                                    <th class="th-score">Overall</th>
                                    <th class="th-score">Coding</th>
                                    <th class="th-score">Tokens/s</th>
                                    <th class="th-score">Latency</th>
                                    <th class="th-score">Traces</th>
                                    <th class="th-score">Snapshots</th>
                                    <th class="th-score">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {sortedRuns.map((r) => {
                                    const pct = (
                                        r.metrics.overall_score * 100
                                    ).toFixed(1);
                                    const tierCls =
                                        parseFloat(pct) >= 90
                                            ? "tier-s"
                                            : parseFloat(pct) >= 80
                                              ? "tier-a"
                                              : parseFloat(pct) >= 65
                                                ? "tier-b"
                                                : parseFloat(pct) >= 50
                                                  ? "tier-c"
                                                  : "tier-f";
                                    return (
                                        <tr>
                                            <td class="td-model">
                                                <div class="model-cell">
                                                    <code
                                                        class="mono-data text-tertiary font-small"
                                                    >
                                                        {r.run_id}
                                                    </code>
                                                </div>
                                            </td>
                                            <td class="td-model">
                                                <div class="model-cell">
                                                    <a
                                                        href={`/model/${encodeURIComponent(r.model)}`}
                                                        class="model-link"
                                                    >
                                                        {r.model}
                                                    </a>
                                                    <span class="model-sub">
                                                        {r.model_metadata
                                                            .size || "—"}
                                                        {r.model_metadata
                                                            .quantization
                                                            ? ` · ${r.model_metadata.quantization}`
                                                            : ""}
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="td-score">
                                                <div class="overall-cell">
                                                    <span class="overall-value">
                                                        {pct}%
                                                    </span>
                                                    <span
                                                        class={`tier-badge ${tierCls} mt-tiny`}
                                                    >
                                                        {parseFloat(pct) >= 90
                                                            ? "S"
                                                            : parseFloat(pct) >=
                                                                80
                                                              ? "A"
                                                              : parseFloat(
                                                                      pct,
                                                                  ) >= 65
                                                                ? "B"
                                                                : parseFloat(
                                                                        pct,
                                                                    ) >= 50
                                                                  ? "C"
                                                                  : "F"}
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="td-score">
                                                <span class="score-chip score-chip-secondary">
                                                    {(
                                                        (r.metrics
                                                            .coding_score ||
                                                            0) * 100
                                                    ).toFixed(1)}
                                                </span>
                                            </td>
                                            <td class="td-score mono-data">
                                                {r.performance.tokens_per_sec.toFixed(
                                                    0,
                                                )}{" "}
                                                t/s
                                            </td>
                                            <td class="td-score mono-data">
                                                {r.performance.total_latency_ms}
                                                ms
                                            </td>
                                            <td class="td-score">
                                                {modelTraceCounts.has(r.model) ? (
                                                    <a
                                                        href={`/traces?model=${encodeURIComponent(r.model)}`}
                                                        class="hist-traces-link"
                                                        title={`${modelTraceCounts.get(r.model)} trace${modelTraceCounts.get(r.model) !== 1 ? "s" : ""} captured`}
                                                        aria-label={`View ${modelTraceCounts.get(r.model)} execution trace${modelTraceCounts.get(r.model) !== 1 ? "s" : ""} for ${r.model}`}
                                                    >
                                                        <span class="material-symbols-outlined hist-traces-icon">
                                                            replay
                                                        </span>
                                                        <span class="hist-traces-count">
                                                            {modelTraceCounts.get(r.model)}
                                                        </span>
                                                    </a>
                                                ) : (
                                                    <span class="hist-traces-none" aria-label="No traces captured">
                                                        —
                                                    </span>
                                                )}
                                            </td>
                                            <td class="td-score">
                                                {modelSnapshotCounts.has(r.model) ? (
                                                    <a
                                                        href={`/traces?model=${encodeURIComponent(r.model)}`}
                                                        class="hist-traces-link"
                                                        title={`${modelSnapshotCounts.get(r.model)} snapshot${modelSnapshotCounts.get(r.model) !== 1 ? "s" : ""} saved`}
                                                        aria-label={`View ${modelSnapshotCounts.get(r.model)} snapshot${modelSnapshotCounts.get(r.model) !== 1 ? "s" : ""} for ${r.model}`}
                                                    >
                                                        <span class="material-symbols-outlined hist-traces-icon">
                                                            camera
                                                        </span>
                                                        <span class="hist-traces-count">
                                                            {modelSnapshotCounts.get(r.model)}
                                                        </span>
                                                    </a>
                                                ) : (
                                                    <span class="hist-traces-none" aria-label="No snapshots saved">
                                                        —
                                                    </span>
                                                )}
                                            </td>
                                            <td
                                                class="td-score mono-data text-tertiary font-small"
                                            >
                                                {new Date(
                                                    r.timestamp,
                                                ).toLocaleDateString("en-US", {
                                                    month: "short",
                                                    day: "numeric",
                                                    year: "numeric",
                                                })}
                                            </td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </div>

                    <div class="lb-footnote">
                        <span class="material-symbols-outlined lb-footnote-icon">
                            history
                        </span>
                        <span class="lb-footnote-text">
                            {sortedRuns.length} runs ·{" "}
                            {new Set(results.map((r) => r.hardware.processor))
                                .size > 0
                                ? [
                                      ...new Set(
                                          results.map(
                                              (r) => r.hardware.processor,
                                          ),
                                      ),
                                  ].join(", ")
                                : "—"}
                            {totalTracedRuns > 0
                                ? ` · ${modelTraceCounts.size} model${modelTraceCounts.size !== 1 ? "s" : ""} with traces`
                                : ""}
                        </span>
                    </div>
                </div>
            </section>
        )
    }
</BaseLayout>

<style is:global>
  /* ── Traces column (History page) ────────────────────────────── */
  .hist-traces-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--text-secondary);
    padding: 2px 8px;
    border-radius: 4px;
    transition: background 150ms ease, color 150ms ease;
  }
  .hist-traces-link:hover {
    background: rgba(59, 130, 246, 0.08);
    color: var(--brand-primary);
  }

  .hist-traces-icon {
    font-size: 14px;
  }

  .hist-traces-count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
  }

  .hist-traces-none {
    color: var(--text-tertiary);
    font-size: 13px;
  }
</style>
