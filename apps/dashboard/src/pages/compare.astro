---
import BaseLayout from '../layouts/BaseLayout.astro';
import TraceComparison from '../components/TraceComparison';
import ErrorBoundary from '../components/ErrorBoundary';
import { loadResults, buildLeaderboard } from '../lib/loadResults';
import { loadTraceManifest, loadTrace, mapTraceToRun } from '../lib/loadTraces';
import type { BenchmarkResult, MetricScores } from '../lib/loadResults';
import type { TraceRun } from '../lib/traceTypes';

const results: BenchmarkResult[] = await loadResults();
const { leaderboard } = buildLeaderboard(results);

const comparisonModels = leaderboard.slice(0, 4);

// Pre-compute winners
const fastestModel = leaderboard.length > 0
  ? leaderboard.reduce((a, b) => a.performance.tokens_per_sec > b.performance.tokens_per_sec ? a : b)
  : null;
const topModel = leaderboard[0] ?? null;

// ── Load real traces for comparison ────────────────────────────
const comparisonTraces: TraceRun[][] = [];
const traceManifest = await loadTraceManifest();
const modelNames = comparisonModels.map(m => m.model);

for (const model of modelNames) {
  const modelTraces = traceManifest.traces
    .filter(t => t.model === model)
    .sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime())
    .slice(0, 3);

  const loaded: TraceRun[] = [];
  for (const entry of modelTraces) {
    const data = await loadTrace(entry.trace_id);
    if (data) loaded.push(mapTraceToRun(data));
  }
  comparisonTraces.push(loaded);
}

// Build comparison rows in frontmatter to avoid complex template expressions
interface CompareRow {
  label: string;
  key: string;
  values: { model: string; display: string; isBest: boolean; badge?: string }[];
}

const compareRows: CompareRow[] = [];

const metricKeys = [
  { label: 'Coding', key: 'coding_score' },
  { label: 'Reasoning', key: 'reasoning_score' },
  { label: 'Instructions', key: 'instruction_score' },
  { label: 'Frontend', key: 'frontend_score' },
  { label: 'Math', key: 'math_score' },
  { label: 'Debugging', key: 'debugging_score' },
  { label: 'Overall', key: 'overall_score' },
];

for (const { label, key } of metricKeys) {
  const row: CompareRow = { label, key, values: [] };
  for (const m of comparisonModels) {
    const val = (m.metrics as MetricScores)[key] ?? 0;
    const isBest = comparisonModels.every(other => ((other.metrics as MetricScores)[key] ?? 0) <= val);
    row.values.push({
      model: m.model,
      display: (val * 100).toFixed(1) + '%',
      isBest,
      badge: isBest ? 'best' : undefined,
    });
  }
  compareRows.push(row);
}

// Speed row
const speedRow: CompareRow = {
  label: 'Speed', key: 'speed', values: [],
};
for (const m of comparisonModels) {
  const val = m.performance.tokens_per_sec;
  const isBest = comparisonModels.every(other => other.performance.tokens_per_sec <= val);
  speedRow.values.push({ model: m.model, display: val.toFixed(0) + ' tok/s', isBest, badge: isBest ? 'fastest' : undefined });
}
compareRows.push(speedRow);

// TTFT row
const ttftRow: CompareRow = { label: 'TTFT', key: 'ttft', values: [] };
for (const m of comparisonModels) {
  const val = m.performance.ttft_ms;
  const isBest = comparisonModels.every(other => other.performance.ttft_ms >= val);
  ttftRow.values.push({ model: m.model, display: val.toFixed(0) + 'ms', isBest, badge: isBest ? 'fastest' : undefined });
}
compareRows.push(ttftRow);

// Stability row
const stabilityRow: CompareRow = { label: 'Stability (σ)', key: 'stability', values: [] };
for (const m of comparisonModels) {
  const val = m.stats.std;
  const isBest = comparisonModels.every(other => other.stats.std >= val);
  stabilityRow.values.push({ model: m.model, display: '±' + val.toFixed(3), isBest, badge: isBest ? 'stable' : undefined });
}
compareRows.push(stabilityRow);

// Issues row
const issuesRow: CompareRow = { label: 'Issues', key: 'issues', values: [] };
for (const m of comparisonModels) {
  const val = m.total_failures;
  const isBest = comparisonModels.every(other => other.total_failures >= val);
  issuesRow.values.push({ model: m.model, display: String(val), isBest, badge: isBest ? 'cleanest' : undefined });
}
compareRows.push(issuesRow);
---

<BaseLayout
  title="Model Comparison"
  description="Head-to-head comparison of LLM performance on Model Lens — coding, reasoning, speed, and stability."
>
  <!-- ═══ Dashboard Header ═══════════════════════════════════════ -->
  <div class="dashboard-header animate-entrance">
    <div>
      <h2 class="dashboard-title">Model Performance Leaderboard</h2>
      <p class="dashboard-subtitle">Aggregated results across {results.length} standardized test traces.</p>
    </div>
    <div class="dashboard-actions">
      <button class="btn-outline btn-disabled" disabled aria-disabled="true" title="Filter — coming soon">
        <span class="material-symbols-outlined icon-18">filter_list</span>
        <span>Filter</span>
      </button>
      <button class="btn-outline btn-disabled" disabled aria-disabled="true" title="Export CSV — coming soon">
        <span class="material-symbols-outlined icon-18">file_download</span>
        <span>Export CSV</span>
      </button>
    </div>
  </div>

  {
    leaderboard.length < 2
    ? <div class="empty-state">
        <span class="material-symbols-outlined empty-state-icon">compare_arrows</span>
        <h3>Not enough models to compare</h3>
        <p class="text-balance">
          Benchmark at least 2 different models to see side-by-side performance comparisons.
        </p>
      </div>
    : <>
        <!-- ═══ Winner Summary ══════════════════════════════════ -->
        <section class="winner-summary">
          <div class="card winner-card">
            <h3 class="winner-label">Best Overall</h3>
            <div class="winner-row">
              <span class="winner-model">{topModel?.model ?? 'N/A'}</span>
              {topModel && <span class="chip chip-primary font-strong">{(topModel.metrics.overall_score * 100).toFixed(1)}%</span>}
            </div>
          </div>
          <div class="card winner-card">
            <h3 class="winner-label">Fastest Throughput</h3>
            {fastestModel
              ? <div class="winner-row">
                  <span class="winner-model">{fastestModel.model}</span>
                  <span class="chip chip-success font-strong">{fastestModel.performance.tokens_per_sec.toFixed(0)} tok/s</span>
                </div>
              : <span class="text-tertiary">N/A</span>
            }
          </div>
        </section>

        <!-- ═══ Side-by-Side Score Table ═══════════════════════ -->
        <section class="dashboard-table">
          <div class="section-header">
            <h2>Side-by-Side Score Table</h2>
            <p>Direct comparison of all metrics — best values highlighted</p>
          </div>
          <div class="card table-card">
            <div class="model-table-wrapper">
            <table class="compare-table">
              <thead>
                <tr>
                  <th>Metric</th>
                  {comparisonModels.map(function(m) { return <th><a href={'/model/' + encodeURIComponent(m.model)} class="model-link">{m.model}</a></th>; })}
                </tr>
              </thead>
              <tbody>
                {compareRows.map(function(row) { return (
                  <tr class={row.key === 'speed' ? 'row-separator' : ''}>
                    <td class="td-label">{row.label}</td>
                    {row.values.map(function(v) { return (
                      <td class={v.isBest ? 'cell-best' : ''}>
                        {v.display}
                        {v.badge && <span class="best-badge">{v.badge}</span>}
                      </td>
                    ); })}
                  </tr>
                ); })}
              </tbody>
            </table>
            </div>
          </div>
        </section>

        <!-- ═══ Trace Comparison ═══════════════════════════════ -->
        {
          comparisonTraces.length >= 2 && comparisonTraces[0].length > 0 && comparisonTraces[1].length > 0 && (
            <section class="dashboard-table section-mt">
              <div class="section-header">
                <h2>Execution Trace Comparison</h2>
                <p>Side-by-side step analysis — compare how each model processes the same prompt</p>
              </div>
              <div class="card table-card">
                <ErrorBoundary client:load>
                  <TraceComparison
                    tracesA={comparisonTraces[0]}
                    tracesB={comparisonTraces[1]}
                    tracesC={comparisonTraces[2]?.length ? comparisonTraces[2] : undefined}
                  />
                </ErrorBoundary>
              </div>
            </section>
          )
        }

        <!-- ═══ Methodology Cards ═══════════════════════════════ -->
        <section class="methodology-section">
          <div class="section-header">
            <h2>Methodology</h2>
            <p>How we evaluate and score benchmark results</p>
          </div>
          <div class="methodology-grid">
            <div class="card methodology-card">
              <h3>Agentic Scrutiny</h3>
              <p>Our agentic score measures the model's ability to maintain state across multi-step tool calls. High scores indicate &lt;5% hallucination rate on function parameters.</p>
            </div>
            <div class="card methodology-card">
              <h3>Speed Normalization</h3>
              <p>Tokens per second (t/s) are recorded on a cold KV cache. Local runs are benchmarked on the specified hardware listed in the table.</p>
            </div>
            <div class="card methodology-card">
              <h3>Hardware Variance</h3>
              <p>Benchmarks are repeated 5 times. The reported values are the arithmetic mean of all valid runs within a 2-sigma variance threshold.</p>
            </div>
          </div>
        </section>
      </>
  }
</BaseLayout>

<style is:global>
  /* Winner summary */
  .winner-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .winner-card {
    padding: 1.25rem;
  }
  .winner-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .winner-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .winner-model {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* ── Methodology ─────────────────────────────────────────── */
  .methodology-section {
    margin-top: 2rem;
  }
  .methodology-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .methodology-card {
    padding: 1.25rem;
  }
  .methodology-card h3 {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .methodology-card p {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* ── Trace Comparison ─────────────────────────────────── */
  .tcmp-root {
    padding: 0;
  }

  .tcmp-diff-bar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0.875rem 1.25rem;
    background: var(--surface-secondary);
    border-bottom: 1px solid var(--border-primary);
    font-size: 12px;
  }
  .tcmp-diff-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
  }
  .tcmp-diff-icon {
    font-size: 14px;
    color: var(--brand-primary);
  }
  .tcmp-diff-text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-primary);
  }
  .tcmp-diff-divider {
    width: 1px;
    height: 16px;
    background: var(--border-secondary);
    margin: 0 1rem;
  }

  .tcmp-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    text-align: center;
  }

  .tcmp-columns {
    display: grid;
    gap: 0;
  }
  .tcmp-column {
    border-right: 1px solid var(--border-primary);
  }
  .tcmp-column:last-child {
    border-right: none;
  }

  .tcmp-col-header {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 1rem 1.25rem;
    background: var(--surface-secondary);
    border-bottom: 2px solid var(--border-primary);
  }
  .tcmp-col-none {
    justify-content: center;
    padding: 2rem;
  }
  .tcmp-col-model {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .tcmp-col-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    margin-top: 2px;
  }
  .tcmp-status-icon {
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .tcmp-status-completed {
    color: var(--success);
  }
  .tcmp-status-failed {
    color: var(--error);
  }
  .tcmp-status-running {
    color: var(--brand-primary);
    animation: spin 1s linear infinite;
  }

  .tcmp-col-steps {
    max-height: 600px;
    overflow-y: auto;
  }

  .tcmp-cell {
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid var(--border-secondary);
    transition: background 150ms ease;
  }
  .tcmp-cell:hover {
    background: var(--surface-hover);
  }
  .tcmp-cell-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    background: var(--surface-secondary);
  }
  .tcmp-empty-label {
    color: var(--text-tertiary);
    font-size: 14px;
  }

  .tcmp-cell-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .tcmp-step-icon {
    font-size: 14px;
    flex-shrink: 0;
  }
  .tcmp-type-chip {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid;
    white-space: nowrap;
  }
  .tcmp-cell-time {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
  }
  .tcmp-cell-label {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-primary);
    margin-left: 22px;
  }
  .tcmp-cell-detail {
    margin-left: 22px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    line-height: 1.4;
    margin-top: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tcmp-fail-icon {
    font-size: 14px;
    margin-left: 22px;
    margin-top: 0.25rem;
    display: inline-block;
  }

  .tcmp-legend {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border-primary);
    font-size: 10px;
    flex-wrap: wrap;
  }
  .tcmp-legend-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tcmp-legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--text-secondary);
  }

  .tcmp-legend-divider {
    color: var(--border-secondary);
    font-size: 10px;
  }

  /* ── Diff Badges ─────────────────────────────────────── */
  .tcmp-delta {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .tcmp-delta-faster {
    background: rgba(34, 197, 94, 0.12);
    color: var(--success);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }
  .tcmp-delta-slower {
    background: rgba(239, 68, 68, 0.12);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }
  .tcmp-delta-equal {
    background: rgba(148, 163, 184, 0.08);
    color: var(--text-tertiary);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .tcmp-delta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }
  .tcmp-dot-faster {
    background: var(--success);
  }
  .tcmp-dot-slower {
    background: var(--error);
  }
</style>
