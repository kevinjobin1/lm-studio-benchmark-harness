---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="404 Not Found"
    description="The page you are looking for does not exist."
>
    <div class="empty-state page-404">
        <span class="material-symbols-outlined icon-404">
            search_off
        </span>
        <h2 class="heading-404">
            404 &mdash; Page Not Found
        </h2>
        <p class="text-404">
            The page you're looking for doesn't exist or has been moved.
        </p>
        <a href="/" class="btn-primary inline-flex-center" style="text-decoration: none;">
            <span class="material-symbols-outlined icon-16">arrow_back</span>
            Back to Dashboard
        </a>
    </div>
</BaseLayout>
