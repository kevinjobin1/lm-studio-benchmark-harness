---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="404 Not Found"
    description="The page you are looking for does not exist."
>
    <div class="empty-state" style="padding: 5rem 2rem; text-align: center;">
        <span class="material-symbols-outlined" style="font-size: 64px; color: var(--text-tertiary); margin-bottom: 1.5rem; display: block;">
            search_off
        </span>
        <h2 style="font-family: var(--font-mono); font-size: 18px; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">
            404 &mdash; Page Not Found
        </h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
            The page you're looking for doesn't exist or has been moved.
        </p>
        <a href="/" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; text-decoration: none;">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Dashboard
        </a>
    </div>
</BaseLayout>
