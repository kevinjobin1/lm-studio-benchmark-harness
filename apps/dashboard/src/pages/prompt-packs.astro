---
import BaseLayout from "../layouts/BaseLayout.astro";
import PackCard from "../components/PackCard";

// ── Pack data (sourced from prompt_packs/*/) ───────────────────
interface PackCategory {
    id: string;
    label: string;
    difficulty: string[];
    count: number;
}
interface PackSkill {
    name: string;
    version?: string;
    description: string;
}
interface PackData {
    name: string;
    version: string;
    description: string;
    tags: string[];
    categories: PackCategory[];
    skills: PackSkill[];
    total_prompts: number;
    author?: string;
    license?: string;
}

