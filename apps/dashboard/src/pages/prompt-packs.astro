---

<BaseLayout
    title="Prompt Packs"
    description="Registry of benchmark evaluation packs — browse, filter, and explore prompt templates and skill configurations."
    activeNav="packs"
>
    <!-- ═══ Dashboard Header ═══════════════════════════════════════ -->
    <div class="dashboard-header animate-entrance">
        <div>
            <h2 class="dashboard-title">Prompt Packs Registry</h2>
            <p class="dashboard-subtitle">
                {packs.length} packs · {
                    packs.reduce((s, p) => s + p.total_prompts, 0)
                } total prompts across all categories.
            </p>
        </div>
        <div class="dashboard-actions">
            <button class="btn-outline">
                <span class="material-symbols-outlined" style="font-size:18px"
                    >add</span
                >
                <span>New Pack</span>
            </button>
        </div>
    </div>

    <!-- ═══ Pack Cards with Filter Sidebar ════════════════════════ -->
    <PackCard client:load packs={packs} />
</BaseLayout>
