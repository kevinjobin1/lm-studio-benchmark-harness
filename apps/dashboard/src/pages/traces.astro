---
import BaseLayout from "../layouts/BaseLayout.astro";
import TracesTabs from "../components/TracesTabs";
import ErrorBoundary from "../components/ErrorBoundary";
import type { TraceRun } from "../lib/traceTypes";
import { loadResults } from "../lib/loadResults";
import { loadTraceManifest, loadTrace, mapTraceToRun } from "../lib/loadTraces";
import type { BenchmarkResult } from "../lib/loadResults";

// Read ?trace_id= from URL to pre-select a specific trace
const url = new URL(Astro.request.url);
const preSelectTraceId = url.searchParams.get("trace_id") || undefined;

// Load benchmark results (fallback for synthesized traces)
const results: BenchmarkResult[] = await loadResults();

// Load real captured traces (V2)
let realTraces: TraceRun[] = [];
try {
  const manifest = await loadTraceManifest();
  if (manifest.traces.length > 0) {
    // Load the 20 most recent traces — use allSettled so one corrupt
    // file doesn't kill the entire batch.
    const recentTraceIds = manifest.traces.slice(0, 20).map(t => t.trace_id);
    const settled = await Promise.allSettled(
      recentTraceIds.map(id => loadTrace(id)),
    );
    realTraces = settled
      .filter(r => r.status === "fulfilled" && r.value !== null)
      .map(r => mapTraceToRun(r.value!));
  }
} catch (e) {
  // Traces not available — fall back to synthesized/demo
}

const totalTraceCount = realTraces.length > 0 ? realTraces.length : results.length;
---

<BaseLayout
    title="Agentic Traces"
    description="Replay and inspect execution traces — step-by-step tool calls, reasoning chains, and response generation."
    activeNav="agentic"
>
    <!-- ═══ Dashboard Header ═══════════════════════════════════════ -->
    <div class="dashboard-header animate-entrance">
        <div>
            <h2 class="dashboard-title">Agentic Traces Explorer</h2>
            <p class="dashboard-subtitle">
                {
                    totalTraceCount > 0
                        ? `Step-by-step execution playback across ${totalTraceCount} trace runs — tool calls, reasoning chains, and response generation.`
                        : "No traces captured yet. Run the benchmark suite to populate execution traces."
                }
            </p>
        </div>
    </div>

    <ErrorBoundary client:load>
        <TracesTabs
            traces={realTraces.length > 0 ? realTraces : undefined}
            results={results.length > 0 ? results : undefined}
            initialTraceId={preSelectTraceId}
        />
    </ErrorBoundary>
</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════
     TRACES PAGE — Tab Bar
     ═══════════════════════════════════════════════════════════════ */

  .traces-tabs-layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .traces-tabs-bar {
    display: flex;
    gap: 0.5rem;
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 0.375rem;
  }

  .traces-tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: left;
    font-family: var(--font-ui);
  }
  .traces-tab-btn:hover {
    background: var(--bg-container-high);
    color: var(--text-primary);
  }
  .traces-tab-active {
    background: var(--bg-container-highest) !important;
    border-color: var(--border-default);
    color: var(--text-primary);
  }
  .traces-tab-active .traces-tab-label {
    color: var(--brand-primary);
    font-weight: 600;
  }

  .traces-tab-icon {
    font-size: 20px !important;
    flex-shrink: 0;
  }

  .traces-tab-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .traces-tab-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    transition: color 0.15s;
  }
  .traces-tab-desc {
    font-size: 11px;
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .traces-tab-content {
    flex: 1;
  }

  /* ── Snapshot Cards (Traces page) ────────────────────────────── */
  .snapshots-section {
    margin-top: 2rem;
    margin-bottom: 3rem;
  }

  .snapshots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.875rem;
  }

  .snapshot-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .snapshot-card:hover {
    border-color: var(--brand-primary);
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.08);
  }

  .snapshot-card-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .snapshot-card-icon {
    font-size: 14px;
    color: var(--brand-primary);
  }
  .snapshot-card-id {
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .snapshot-card-model {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .snapshot-card-prompt {
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .snapshot-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .snapshot-card-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
  }
  .snapshot-card-meta .material-symbols-outlined {
    font-size: 12px;
  }

  .snapshot-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--brand-primary);
    transition: gap 150ms ease;
  }
  .snapshot-card:hover .snapshot-card-link {
    gap: 0.5rem;
  }
  .snapshot-card-link .material-symbols-outlined {
    font-size: 12px;
  }
</style>
