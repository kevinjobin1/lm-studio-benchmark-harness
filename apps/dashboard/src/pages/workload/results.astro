    border-color: rgba(251, 191, 36, 0.3);
  }
  .wl-model-name {
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .wl-model-provider {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .wl-model-scores {
    display: flex;
    gap: 0.5rem;
  }
  .wl-score-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.375rem 0.75rem;
    background: var(--bg-low);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    min-width: 80px;
  }
  .wl-score-best {
    background: rgba(78, 222, 163, 0.06);
    border-color: rgba(78, 222, 163, 0.15);
  }
  .wl-score-value {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    color: var(--brand-primary);
    line-height: 1.2;
  }
  .wl-score-best .wl-score-value {
    color: var(--success);
  }
  .wl-score-label {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .wl-model-meta {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .wl-model-tasks {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-tertiary);
    margin-left: auto;
  }

  /* ── Per-project breakdown ────────────────────────────────── */
  .wl-project-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }
  .wl-project-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.5rem;
    background: var(--bg-low);
    border-radius: var(--radius-sm);
    gap: 1rem;
  }
  .wl-project-row-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .wl-project-name-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--brand-primary);
    padding: 1px 6px;
    background: rgba(173, 198, 255, 0.08);
    border-radius: var(--radius-sm);
    min-width: 80px;
  }
  .wl-project-score {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    min-width: 50px;
  }
  .wl-project-tasks {
    font-family: var(--font-ui);
    font-size: 10px;
    color: var(--text-tertiary);
  }
  .wl-project-row-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
  }
  .wl-score-bar-track {
    flex: 1;
    height: 6px;
    background: var(--bg-container-highest);
    border-radius: 3px;
    overflow: hidden;
    min-width: 80px;
  }
  .wl-score-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: var(--brand-primary);
    transition: width 0.6s ease;
    min-width: 2px;
  }
  .wl-project-time {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    flex-shrink: 0;
    min-width: 40px;
    text-align: right;
  }

  /* ── Expanded Details ─────────────────────────────────────── */
  .wl-model-details {
    margin-top: 0.25rem;
  }
  .wl-details-summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: background 0.12s, color 0.12s;
    user-select: none;
  }
  .wl-details-summary:hover {
    background: var(--bg-container-high);
    color: var(--text-primary);
  }
  .wl-details-summary .material-symbols-outlined {
    font-size: 16px !important;
  }
  .wl-details-body {
    padding: 0.75rem 0.5rem 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .wl-details-section {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .wl-details-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .wl-task-chips,
  .wl-failure-chips,
  .wl-strength-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .wl-no-data {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-tertiary);
    font-style: italic;
  }

  /* ── Project Summary Cards ────────────────────────────────── */
  .wl-projects-summary {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.875rem;
  }
  .wl-project-summary-card {
    padding: 1.125rem;
    transition: border-color 150ms ease;
  }
  .wl-project-summary-card:hover {
    border-color: var(--border-prominent);
  }
  .wl-ps-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.375rem;
  }
  .wl-ps-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .wl-ps-score {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--brand-primary);
  }
  .wl-ps-meta {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .wl-ps-models,
  .wl-ps-tasks {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .wl-ps-bar {
    margin-bottom: 0.625rem;
  }
  .wl-ps-models-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .wl-ps-model-chip {
    padding: 2px 8px;
    background: var(--bg-low);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
  }

  /* ── Code Block (for empty state) ─────────────────────────── */
  .wl-code-block {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-lowest);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
  }
  .wl-code-block code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--brand-primary);
    word-break: break-all;
  }
  .wl-copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.12s;
  }
  .wl-copy-btn:hover {
    background: var(--bg-container);
    color: var(--brand-primary);
    border-color: var(--brand-primary);
  }
  .wl-copy-btn .material-symbols-outlined {
    font-size: 14px !important;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    .wl-summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wl-projects-summary {
      grid-template-columns: 1fr;
    }
    .wl-model-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .wl-project-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .wl-project-row-right {
      width: 100%;
    }
  }
</style>
