---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModelDetail from "../../components/ModelDetail";

export function getStaticPaths() {
    // Static mode with client-side data loading — render a catch-all page.
    // The React component handles data fetching and routing.
    return [{ params: { id: "[...id]" } }];
}

const { id } = Astro.params;
const decodedId = decodeURIComponent(id ?? "");
---

<BaseLayout
    title={decodedId}
    description={`Benchmark results for ${decodedId} — coding, reasoning, latency on Apple Silicon`}
>
    <a href="/" class="back-link">
        <span class="material-symbols-outlined" style="font-size: 16px;"
            >arrow_back</span
        >
        Back to Dashboard
    </a>
    <ModelDetail client:load modelId={decodedId} />
</BaseLayout>
