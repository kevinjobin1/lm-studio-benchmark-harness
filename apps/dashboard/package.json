{
  "name": "lmbench-dashboard",
  "version": "1.0.0",
  "description": "Dashboard for LM Studio Benchmark results - model comparison, radar charts, failure heatmaps",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate-results": "python3 scripts/generate_results_json.py",
    "generate-demo": "python3 scripts/generate_results_json.py --demo",
    "generate-real": "python3 scripts/generate_real_results.py",
    "prebuild": "npm run generate-real",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node dist/server/entry.mjs",
    "cf-build": "astro build"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.2",
    "@astrojs/react": "5.0.6",
    "astro": "6.4.2",
    "chart.js": "^4.4.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.8"
  }
}
