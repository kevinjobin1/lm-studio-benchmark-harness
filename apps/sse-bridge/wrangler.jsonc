{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modellens-sse-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SSE_BRIDGE", "class_name": "SSEBridgeDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SSEBridgeDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
