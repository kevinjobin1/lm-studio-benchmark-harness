{
  "_deprecated": "This flat JSON config is fully deprecated as of v2.0.0. All settings live in config.yaml under the 'devbench:' section. This file is kept for backward-compatibility only. Loading it will emit a deprecation warning.",
  "_migration_guide": "Copy any custom settings from this file into config.yaml under the 'devbench:' key, then delete this file.",
  "version": "2.0.0",
  "benchmark_name": "LM Studio DevBench",
  "description": "Public benchmark for local small AI models on Apple Silicon",
  
  "models": {
    "auto_detect": true,
    "specific_models": [],
    "metadata_fields": ["size", "quantization", "parameters"]
  },
  
  "endpoint": {
    "base_url": "http://localhost:1234/v1",
    "api_key": "lm-studio",
    "timeout": 30
  },
  
  "generation": {
    "temperature": 0.2,
    "max_tokens": 1000,
    "top_p": 0.9,
    "stream": true
  },
  
  "prompts": {
    "generator": "auto",
    "total_count": 20,
    "categories": {
      "code": {
        "enabled": true,
        "weight": 0.4,
        "count": 8,
        "subcategories": ["nestjs", "react", "typescript"]
      },
      "frontend": {
        "enabled": true,
        "weight": 0.2,
        "count": 4,
        "subcategories": ["react", "threejs", "tailwind"]
      },
      "reasoning": {
        "enabled": true,
        "weight": 0.15,
        "count": 3,
        "subcategories": ["architecture", "system_design"]
      },
      "math": {
        "enabled": true,
        "weight": 0.15,
        "count": 3,
        "subcategories": ["developer_math"]
      },
      "instruction": {
        "enabled": true,
        "weight": 0.05,
        "count": 1,
        "subcategories": ["json", "formatting"]
      },
      "debugging": {
        "enabled": true,
        "weight": 0.05,
        "count": 1,
        "subcategories": ["race_condition", "di_bug", "stale_closure"]
      }
    },
    "difficulty_distribution": {
      "easy": 0.3,
      "medium": 0.5,
      "hard": 0.2
    }
  },
  
  "evaluation": {
    "runs_per_prompt": 5,
    "parallel_execution": true,
    "max_workers": 3,
    "execution_grounded": {
      "enabled": true,
      "ts_node": true,
      "tsc": true,
      "eslint": true
    },
    "statistical": {
      "confidence_interval": 0.95,
      "outlier_detection": true,
      "outlier_method": "iqr"
    }
  },
  
  "metrics": {
    "track_latency": true,
    "track_memory": true,
    "track_thermal": false,
    "tokenization_aware": true,
    "normalization_reference_length": 100
  },
  
  "output": {
    "directory": "devbench_results",
    "formats": ["json", "csv", "markdown"],
    "charts": ["radar", "leaderboard"],
    "x_thread": true
  },
  
  "hardware": {
    "target": "apple_silicon",
    "memory_gb": 18,
    "architecture": "arm64"
  },
  
  "reproducibility": {
    "seed": null,
    "deterministic": false,
    "version_prompts": true
  }
}
