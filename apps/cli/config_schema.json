{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Lens Unified Configuration Schema",
  "description": "Validates config.yaml for both the general benchmark suite and DevBench v2. The old config.json (DevBench-only flat JSON) is deprecated.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the config schema"
    },
    "api": {
      "type": "object",
      "description": "Shared API connection settings (general + devbench)",
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Provider API base URL"
        },
        "api_key": {
          "type": "string",
          "description": "API key for authentication"
        },
        "model_name": {
          "type": "string",
          "description": "Default model name"
        },
        "timeout": {
          "type": "number",
          "minimum": 1,
          "description": "Request timeout in seconds"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum retry attempts"
        }
      }
    },
    "model": {
      "type": "object",
      "description": "Model generation parameters shared across benchmarks",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "general": {
      "type": "object",
      "description": "General benchmark suite (MMLU-Pro, GSM8K, HumanEval, etc.)",
      "required": ["benchmarks"],
      "properties": {
        "samples_per_benchmark": {
          "type": "integer",
          "minimum": 1,
          "description": "Default number of samples for each benchmark"
        },
        "quick_mode_samples": {
          "type": "integer",
          "minimum": 1,
          "description": "Reduced sample count for quick mode"
        },
        "benchmarks": {
          "type": "object",
          "description": "Per-benchmark configuration",
          "properties": {
            "mmlu_pro": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "subjects": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "gsm8k": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "aime": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "humaneval": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "swe_bench_lite": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "max_tasks": { "type": "integer", "minimum": 1 }
              }
            },
            "ifeval": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "needle_in_haystack": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "context_lengths": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "bfcl": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "categories": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "speed_latency": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "prompt_lengths": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "memory": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "monitor_interval": { "type": "number", "minimum": 0 }
              }
            },
            "creativity": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "prompts_file": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "devbench": {
      "type": "object",
      "description": "DevBench v2 — TypeScript/NestJS/React evaluation on Apple Silicon",
      "properties": {
        "description": { "type": "string" },
        "models": {
          "type": "object",
          "properties": {
            "auto_detect": { "type": "boolean" },
            "metadata_fields": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "base_url": { "type": "string", "format": "uri" },
            "api_key": { "type": "string" },
            "timeout": { "type": "number", "minimum": 1 }
          }
        },
        "generation": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
            "stream": { "type": "boolean" }
          }
        },
        "prompts": {
          "type": "object",
          "properties": {
            "generator": { "type": "string", "enum": ["auto", "static", "hybrid"] },
            "total_count": { "type": "integer", "minimum": 1 },
            "categories": { "type": "object" },
            "difficulty_distribution": {
              "type": "object",
              "properties": {
                "easy": { "type": "number", "minimum": 0, "maximum": 1 },
                "medium": { "type": "number", "minimum": 0, "maximum": 1 },
                "hard": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "runs_per_prompt": { "type": "integer", "minimum": 1 },
            "parallel_execution": { "type": "boolean" },
            "max_workers": { "type": "integer", "minimum": 1 },
            "execution_grounded": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "ts_node": { "type": "boolean" },
                "tsc": { "type": "boolean" },
                "eslint": { "type": "boolean" }
              }
            },
            "statistical": {
              "type": "object",
              "properties": {
                "confidence_interval": { "type": "number", "minimum": 0, "maximum": 1 },
                "outlier_detection": { "type": "boolean" },
                "outlier_method": { "type": "string", "enum": ["iqr", "zscore", "isolation"] }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "track_latency": { "type": "boolean" },
            "track_memory": { "type": "boolean" },
            "track_thermal": { "type": "boolean" },
            "tokenization_aware": { "type": "boolean" },
            "normalization_reference_length": { "type": "integer", "minimum": 1 }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "directory": { "type": "string" },
            "formats": {
              "type": "array",
              "items": { "type": "string", "enum": ["json", "csv", "markdown"] }
            },
            "charts": {
              "type": "array",
              "items": { "type": "string", "enum": ["radar", "leaderboard"] }
            }
          }
        },
        "hardware": {
          "type": "object",
          "properties": {
            "target": { "type": "string", "enum": ["apple_silicon", "nvidia", "cpu"] },
            "memory_gb": { "type": "number", "minimum": 1 },
            "architecture": { "type": "string", "enum": ["arm64", "x86_64"] }
          }
        },
        "reproducibility": {
          "type": "object",
          "properties": {
            "seed": { "type": ["integer", "null"] },
            "deterministic": { "type": "boolean" },
            "version_prompts": { "type": "boolean" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Global output settings",
      "properties": {
        "directory": { "type": "string" },
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["json", "csv", "html"] }
        },
        "save_intermediate": { "type": "boolean" },
        "verbose": { "type": "boolean" }
      }
    }
  }
}
