---
import DashboardHeader from './DashboardHeader.astro';
import RadarPanel from './RadarPanel.astro';
import ThroughputPanel from './ThroughputPanel.astro';
import BenchmarkMatrix from './BenchmarkMatrix.astro';
import FailureHeatmapPanel from './FailureHeatmapPanel.astro';
import SystemResources from './SystemResources.astro';
import type { ModelSummary, BenchmarkResult } from '../lib/loadResults';

interface Props {
  models: ModelSummary[];
  results: BenchmarkResult[];
  uniqueModels: string[];
  avgLatencyMs: string;
  avgMemoryGB: string;
  totalMemoryGB: string;
  p95LatencyMs: string;
  memoryUtilPct: number;
  topModels: ModelSummary[];
}

const { models, results, uniqueModels, avgLatencyMs, avgMemoryGB, totalMemoryGB, p95LatencyMs, memoryUtilPct, topModels } = Astro.props;
---

<DashboardHeader
  title="Model Performance Overview"
  subtitle={`Cross-evaluation of local LLM performance on unified hardware clusters.${uniqueModels.length > 0 ? ` ${uniqueModels.length} models · ${results.length} runs` : ''}`}
/>

<!-- ═══ Charts Row: Radar + Throughput ════════════════════ -->
<section class="dashboard-charts">
  <RadarPanel models={models} topModels={topModels} />
  <ThroughputPanel models={models} />
</section>

<!-- ═══ Benchmark Matrix Table ═══════════════════════════ -->
<BenchmarkMatrix models={models} />

<!-- ═══ Failure Breakdown ════════════════════════════════ -->
<FailureHeatmapPanel results={results} />

<!-- ═══ System Resources ═════════════════════════════════ -->
<SystemResources avgLatencyMs={avgLatencyMs} avgMemoryGB={avgMemoryGB} totalMemoryGB={totalMemoryGB} p95LatencyMs={p95LatencyMs} memoryUtilPct={memoryUtilPct} resultsCount={results.length} />
