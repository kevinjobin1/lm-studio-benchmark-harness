{
  "id": "nestjs_auth",
  "prompts": [
    {
      "id": "nestjs_auth_001",
      "task": "Implement JWT refresh token rotation",
      "template": "Implement a NestJS {feature} with JWT validation and {access_level} access control. Support refresh token rotation with token blacklisting.",
      "params": {
        "feature": ["AuthGuard", "custom decorator", "interceptor", "pipe"],
        "access_level": ["role-based", "permission-based", "attribute-based"]
      },
      "constraints": [
        "NestJS only",
        "Use @nestjs/jwt",
        "Handle token revocation",
        "Include refresh token rotation"
      ],
      "expected_keywords": ["@Injectable", "AuthGuard", "JwtService", "role", "refresh", "token", "CanActivate"],
      "difficulty": "hard"
    },
    {
      "id": "nestjs_auth_002",
      "task": "Implement role-based access control (RBAC) decorator",
      "template": "Create a custom NestJS decorator for {access_level} access control that checks user roles from JWT claims.",
      "params": {
        "access_level": ["role-based", "permission-based", "hierarchical"]
      },
      "constraints": [
        "Custom @Roles() decorator",
        "Guard must check roles",
        "Support multiple roles per route"
      ],
      "expected_keywords": ["@Roles", "Reflector", "CanActivate", "SetMetadata", "role", "guard"],
      "difficulty": "medium"
    },
    {
      "id": "nestjs_auth_003",
      "task": "Implement API key authentication strategy",
      "template": "Implement a NestJS {feature} for API key authentication with rate limiting per API key.",
      "params": {
        "feature": ["custom strategy", "passport strategy", "header-based auth"]
      },
      "constraints": [
        "Read API key from X-API-Key header",
        "Validate against database",
        "Include rate limiting"
      ],
      "expected_keywords": ["@Injectable", "PassportStrategy", "validate", "api-key", "header", "rate"],
      "difficulty": "medium"
    }
  ]
}
